---
const { lang } = Astro.props as { lang: 'ro' | 'en' };
const say = (ro: string, en: string) => lang === 'ro' ? ro : en;
---
<section class="dossier-hero" aria-labelledby="launch-title">
  <div class="wrap dossier-hero-grid">
    <div class="dossier-copy">
      <p class="dossier-running">{say('Ediția națională · Suceava · 2027', 'National stage · Suceava · 2027')}</p>
      <h1 id="launch-title">ONTI <span>2027</span></h1>
      <p class="dossier-title">{say('Olimpiada Națională de Tehnologia Informației', 'National Olympiad in Information Technology')}</p>
      <p class="dossier-intro">{say('Detalii despre concurs, program și sosirea la Suceava.', 'Details about the contest, its schedule and arriving in Suceava.')}</p>
      <div class="dossier-actions"><a class="button" href={`/${lang}/concurs`}>{say('Vezi concursul', 'View the contest')} <span aria-hidden="true">→</span></a><a class="text-link" href={`/${lang}/program`}>{say('Program orientativ', 'Provisional schedule')}</a></div>
    </div>
    <figure class="dossier-photo">
      <img src="/images/cnscm-cover.webp" width="1800" height="1350" fetchpriority="high" alt={say('Colegiul Național Ștefan cel Mare din Suceava', 'Colegiul Național Ștefan cel Mare in Suceava')} />
    </figure>
    <a class="dossier-host" href="https://cnstefancelmare.ro/" target="_blank" rel="noreferrer"><img src="/cnscm-logo.png" width="30" height="42" alt="" /><span>{say('Gazda ediției: CNSCM Suceava', 'Edition host: CNSCM Suceava')}</span><b aria-hidden="true">↗</b></a>
  </div>
</section>
