---
import { eventConfig, dateIsKnown } from '../event.config';
const { lang } = Astro.props as { lang: 'ro' | 'en' };
const say = (ro: string, en: string) => lang === 'ro' ? ro : en;
const date = dateIsKnown
  ? new Date(eventConfig.startDate!).toLocaleDateString(lang === 'ro' ? 'ro-RO' : 'en-GB', { dateStyle: 'long', timeZone: 'Europe/Bucharest' })
  : say('Calendarul va fi anunțat în curând.', 'Dates will be announced soon.');
---
<section class="home-hero" aria-labelledby="launch-title">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="launch-title">{say('Viitorul începe', 'The future starts')}{' '}<span>{say('cu ideile tale.', 'with your ideas.')}</span></h1>
        <p class="hero-description"><strong>ONTI 2027 · Suceava</strong>{say('Olimpiada Națională de Tehnologia Informației. Ne întâlnim în Bucovina, la Colegiul Național „Ștefan cel Mare”.', 'Romania’s National Olympiad in Information Technology. Meet us in Bucovina, at Colegiul Național „Ștefan cel Mare”.')}</p>
        <div class="hero-actions">
          <a class="button" href={`/${lang}/participare`}>{say('Ghid de participare', 'Participation guide')}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7"/></svg></a>
          <a class="text-link" href={`/${lang}/concurs`}>{say('Descoperă concursul', 'Explore the contest')}</a>
        </div>
        <a class="hero-date" href={`/${lang}/program`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 2v6M17 2v6M3 11h18"/></svg>{date}</a>
      </div>
      <figure class="hero-photo">
        <img src="/images/cnscm-exterior.webp" width="1600" height="1200" fetchpriority="high" alt={say('Fațada Colegiului Național „Ștefan cel Mare” din Suceava', 'The façade of Colegiul Național „Ștefan cel Mare” in Suceava')} />
        <figcaption><span>{say('Gazda noastră', 'Our host')}</span><a href={`/${lang}/gazda`}>Colegiul Național<br />„Ștefan cel Mare”<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19L19 5M5 5h14v14"/></svg></a></figcaption>
      </figure>
    </div>
    <div class="hero-bottom">
      <a class="hero-scroll" href="#discover">{say('Cunoaște ediția 2027', 'Discover the 2027 edition')}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 4v16M5 13l7 7 7-7"/></svg></a>
      <p class="photo-credit">{say('Fotografie:', 'Photo:')} <a href="https://commons.wikimedia.org/wiki/File:%C8%98tefan_cel_Mare_National_College.jpg">Rosenborg BK Fan</a> · CC0</p>
    </div>
  </div>
</section>

<style>
  .home-hero { background: color-mix(in srgb, var(--gold) 5%, var(--paper)); padding: 56px 0 0; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .hero-copy { padding: 20px 0; animation: hero-in .65s ease both; }
  h1 { margin: 0 0 28px; font-size: clamp(3.25rem, 4.9vw, 4.6rem); font-weight: 650; line-height: 1.06; letter-spacing: -.04em; text-wrap: initial; }
  h1 span { display: block; color: var(--gold-ink); }
  .hero-description { max-width: 460px; margin: 0; font-size: 1.0625rem; line-height: 1.75; color: var(--ink-soft); }
  .hero-description strong { display: block; color: var(--ink); font-weight: 600; margin-bottom: 10px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 24px; margin: 32px 0 22px; }
  .hero-actions .button { gap: 12px; }
  .hero-date { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-soft); font-size: .875rem; text-decoration: none; min-height: 44px; }
  .hero-date svg { flex-shrink: 0; }
  .hero-date:hover { text-decoration: underline; }
  .hero-photo { margin: 0; position: relative; height: 540px; border-radius: 24px; overflow: hidden; background: var(--surface); animation: hero-in .8s ease both; }
  .hero-photo img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 51% center; }
  .hero-photo::after { content: ''; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, #071124eb); pointer-events: none; }
  figcaption { position: absolute; bottom: 32px; left: 32px; right: 32px; z-index: 1; color: #fff; }
  figcaption > span { font-size: .875rem; display: block; margin-bottom: 8px; color: #e4e7ec; }
  figcaption a { display: block; position: relative; padding-right: 32px; font-size: 1.625rem; line-height: 1.3; font-weight: 550; letter-spacing: -.025em; text-decoration: none; color: #fff; }
  figcaption a:hover { color: #f4d998; }
  figcaption svg { position: absolute; right: 0; bottom: 4px; }
  .hero-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 0; }
  .hero-scroll { display: inline-flex; gap: 18px; align-items: center; min-height: 44px; font-size: .875rem; text-decoration: none; }
  .hero-scroll svg { color: var(--gold-ink); }
  .hero-bottom .photo-credit { margin: 0; text-align: right; font-size: .75rem; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1100px) { .hero-grid { gap: 32px; } h1 { font-size: clamp(2.7rem, 5vw, 3.5rem); } .hero-photo { height: 500px; } }
  @media (max-width: 760px) {
    .home-hero { padding-top: 32px; }
    .hero-grid { grid-template-columns: 1fr; gap: 24px; }
    .hero-copy { padding: 0; }
    h1 { font-size: clamp(2.5rem, 10.5vw, 4rem); margin-bottom: 24px; }
    .hero-description { max-width: 550px; font-size: 1rem; }
    .hero-actions { margin: 24px 0 12px; gap: 8px 22px; }
    .hero-photo { height: 340px; border-radius: 18px; }
    .hero-photo img { object-position: center 48%; }
    figcaption { left: 24px; right: 24px; bottom: 24px; }
    figcaption a { font-size: 1.375rem; }
    .hero-bottom { flex-wrap: wrap; gap: 2px; padding: 16px 0 20px; }
    .hero-bottom .photo-credit { text-align: left; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-copy, .hero-photo { animation: none; } }
</style>
