---
import '../styles/global.css';
import { eventConfig } from '../event.config';
import { copy } from '../content/site';
const { title = 'ONTIC 2027', description = 'Olimpiada Națională de Tehnologia Informației și Comunicațiilor · Suceava, România', lang = 'ro' } = Astro.props as { title?: string; description?: string; lang: 'ro' | 'en' };
const t = copy[lang];
const path = Astro.url.pathname.replace(/^\/(ro|en)/, '') || '/';
const altLang = lang === 'ro' ? 'en' : 'ro';
const canonical = new URL(`/${lang}${path === '/' ? '' : path}`, Astro.site).toString();
---
<!doctype html>
<html lang={lang} data-plausible-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10261f" />
    <title>{title} · ONTIC 2027</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ro" href={new URL(`/ro${path === '/' ? '' : path}`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path === '/' ? '' : path}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/ro${path === '/' ? '' : path}`, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" /><meta property="og:title" content={`${title} · ONTIC 2027`} /><meta property="og:description" content={description} /><meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_GB'} /><meta property="og:image" content={new URL('/images/ontic-social.svg', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Event', name: eventConfig.name, description: eventConfig.fullName, eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', ...(eventConfig.startDate ? { startDate: eventConfig.startDate, endDate: new Date(new Date(eventConfig.startDate).getTime() + (eventConfig.durationDays - 1) * 86400000).toISOString() } : {}), location: { '@type': 'Place', name: eventConfig.venue, address: { '@type': 'PostalAddress', addressLocality: eventConfig.city, addressCountry: 'RO' } }, organizer: [{ '@type': 'Organization', name: 'Ministerul Educației și Cercetării' }, { '@type': 'Organization', name: 'Inspectoratul Școlar Județean Suceava' }, { '@type': 'EducationalOrganization', name: eventConfig.host }] })} />
    {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && <script async src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
  </head>
  <body class="font-sans antialiased">
    <a class="skip-link" href="#main">Sari la conținut / Skip to content</a>
    <header class="site-header"><div class="header-inner">
      <a class="brand" href={`/${lang}`} aria-label={`ONTIC 2027 — ${eventConfig.shortHost}`}><img src="/ontic-logo.svg" width="50" height="50" alt="" /><span class="brand-word"><strong>ONTIC<span>27</span></strong><small>{eventConfig.shortHost}</small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b class="sr-only">Meniu / Menu</b></button>
      <nav id="main-nav" aria-label="Navigare principală"><div class="nav-links">{t.nav.map(([label, href]) => <a href={`/${lang}${href}`} class:list={{ active: path === href || (href === '/concurs' && path.startsWith('/concurs')) }}>{label}</a>)}</div>
        <div class="nav-tools"><a class="language" href={`/${altLang}${path === '/' ? '' : path}`} lang={altLang} aria-label={lang === 'ro' ? 'Switch to English' : 'Schimbă în română'}>{lang === 'ro' ? 'EN' : 'RO'}</a><button class="theme-toggle" aria-label="Schimbă tema luminoasă/întunecată" title="Schimbă tema"><span aria-hidden="true">◐</span></button></div>
      </nav>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="footer-main wrap">
      <div class="footer-brand"><a class="brand" href={`/${lang}`}><img src="/ontic-logo.svg" width="50" height="50" alt="" /><span class="brand-word"><strong>ONTIC<span>27</span></strong><small>{eventConfig.shortHost}</small></span></a><p>{t.footerTag}</p></div>
      <div><h2>{lang === 'ro' ? 'Organizatori' : 'Organizers'}</h2><p>Ministerul Educației și Cercetării</p><p>Inspectoratul Școlar Județean Suceava</p><p><a href={`/${lang}/gazda`}>{eventConfig.host}</a></p></div>
      <div><h2>{lang === 'ro' ? 'Contact' : 'Contact'}</h2><p>{eventConfig.email}</p><p>{eventConfig.phone}</p><div class="socials"><a href={eventConfig.social.facebook || '#contact'} aria-label="Facebook">f</a><a href={eventConfig.social.instagram || '#contact'} aria-label="Instagram">◎</a><a href={eventConfig.social.youtube || '#contact'} aria-label="YouTube">▶</a></div></div>
      <div><h2>{lang === 'ro' ? 'Informații' : 'Information'}</h2><a href={`/${lang}/confidentialitate`}>{lang === 'ro' ? 'Confidențialitate' : 'Privacy'}</a><a href={`/${lang}/cookies`}>Cookies</a><a href={`/${lang}/termeni`}>{lang === 'ro' ? 'Termeni' : 'Terms'}</a><a href={`/${lang}/accesibilitate`}>{lang === 'ro' ? 'Accesibilitate' : 'Accessibility'}</a></div>
    </div><div class="footer-bottom wrap"><span>© {eventConfig.year} ONTIC · Suceava, România</span><span>{lang === 'ro' ? 'Realizat cu grijă în Bucovina' : 'Made with care in Bucovina'}</span></div></footer>
    <div class="cookie-banner" hidden role="dialog" aria-label="Preferințe cookie"><div><strong>Preferințe cookie</strong><p>Folosim doar cookie-uri funcționale. Analitica privacy-friendly este opțională.</p></div><button data-cookie="essential">Doar esențiale</button><button class="button button-small" data-cookie="all">Acceptă analitica</button></div>
    <script>
      // @ts-nocheck
      const header = document.querySelector('.site-header');
      const menu = document.querySelector('.menu-toggle');
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); header?.classList.toggle('menu-open', open); });
      const theme = localStorage.getItem('ontic-theme'); if (theme) document.documentElement.dataset.theme = theme;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; localStorage.setItem('ontic-theme', next); });
      const loadAnalytics = () => { const domain = document.documentElement.dataset.plausibleDomain; if (!domain || document.querySelector('[data-ontic-analytics]')) return; const s = document.createElement('script'); s.defer = true; s.src = 'https://plausible.io/js/script.js'; s.dataset.domain = domain; s.dataset.onticAnalytics = 'true'; document.head.append(s); };
      const banner = document.querySelector('.cookie-banner'); const choice = localStorage.getItem('ontic-cookie-choice'); if (choice === 'all') loadAnalytics(); if (!choice && !location.pathname.includes('/confidentialitate')) banner.hidden = false;
      document.querySelectorAll('[data-cookie]').forEach(b => b.addEventListener('click', () => { localStorage.setItem('ontic-cookie-choice', b.dataset.cookie); banner.hidden = true; if (b.dataset.cookie === 'all') loadAnalytics(); }));
    </script>
    <script>import '../scripts/maps';</script>
  </body>
</html>
