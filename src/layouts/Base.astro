---
import '../styles/site.css';
import '../styles/refresh.css';
import { eventConfig } from '../event.config';
import { copy } from '../content/site';
const { title = 'ONTI 2027', description = 'Olimpiada Națională de Tehnologia Informației · Suceava, România', lang = 'ro' } = Astro.props as { title?: string; description?: string; lang: 'ro' | 'en' };
const t = copy[lang];
const path = Astro.url.pathname.replace(/^\/(ro|en)/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const canonical = new URL(`/${lang}${path === '/' ? '' : path}`, Astro.site).toString();
---
<!doctype html>
<html lang={lang} data-theme="light" data-plausible-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} · ONTI 2027</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ro" href={new URL(`/ro${path === '/' ? '' : path}`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path === '/' ? '' : path}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/ro${path === '/' ? '' : path}`, Astro.site)} />
    <link rel="icon" type="image/png" href="/cnscm-logo.png" />
    <link rel="preload" href="/fonts/manrope-variable.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" /><meta property="og:title" content={`${title} · ONTI 2027`} /><meta property="og:description" content={description} /><meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_GB'} /><meta property="og:image" content={new URL('/images/ontic-social.svg', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Event', name: eventConfig.name, description: eventConfig.fullName, eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', ...(eventConfig.startDate ? { startDate: eventConfig.startDate, endDate: new Date(new Date(eventConfig.startDate).getTime() + (eventConfig.durationDays - 1) * 86400000).toISOString() } : {}), location: { '@type': 'Place', name: eventConfig.venue, address: { '@type': 'PostalAddress', addressLocality: eventConfig.city, addressCountry: 'RO' } }, organizer: [{ '@type': 'Organization', name: 'Ministerul Educației și Cercetării' }, { '@type': 'Organization', name: 'Inspectoratul Școlar Județean Suceava' }, { '@type': 'EducationalOrganization', name: eventConfig.host }] })} />
    {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && <script async src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Sari la conținut</a>
    <header class="site-header"><div class="header-inner wrap">
      <a class="brand" href={`/${lang}`} aria-label={`ONTI 2027 — ${eventConfig.shortHost}`}><img src="/cnscm-logo.png" width="34" height="48" alt="" /><span class="brand-word"><strong>ONTI<span>27</span></strong><small>Suceava · 2027</small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b class="sr-only">Meniu</b></button>
      <nav id="main-nav" aria-label={lang === 'ro' ? 'Navigare principală' : 'Main navigation'}>
        <div class="nav-links">
          <a href={`/${lang}/concurs`} class:list={{ active: isActive('/concurs') }}>{lang === 'ro' ? 'Concurs' : 'Contest'}</a>
          <a href={`/${lang}/program`} class:list={{ active: isActive('/program') }}>{lang === 'ro' ? 'Program' : 'Schedule'}</a>
          <a href={`/${lang}/participare`} class:list={{ active: isActive('/participare') }}>{lang === 'ro' ? 'Participare' : 'Participation'}</a>
        </div>
        <a href={`/${lang}/locatii`} class:list={{ active: ['/locatii','/bucovina','/calatorie'].some(isActive) }}>{lang === 'ro' ? 'Suceava' : 'Suceava'}</a>
        <a href={`/${lang}/stiri`} class:list={{ active: ['/stiri','/faq','/contact'].some(isActive) }}>{lang === 'ro' ? 'Informații' : 'Information'}</a>
      </nav>
    </div><div class="scroll-progress" aria-hidden="true"></div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="footer-main wrap">
      <div class="footer-brand"><a class="brand" href={`/${lang}`}><img src="/cnscm-logo.png" width="34" height="48" alt="" /><span class="brand-word"><strong>ONTI<span>27</span></strong><small>Suceava · 2027</small></span></a><p>{t.footerTag}</p></div>
      <div><h2>{lang === 'ro' ? 'Organizatori' : 'Organizers'}</h2><p>Ministerul Educației și Cercetării</p><p>Inspectoratul Școlar Județean Suceava</p><p><a href="https://cnstefancelmare.ro/" target="_blank" rel="noreferrer">{eventConfig.host} ↗</a></p></div>
      <div><h2>{lang === 'ro' ? 'Contact' : 'Contact'}</h2><p>{eventConfig.email.startsWith('[DE COMPLETAT') ? (lang === 'ro' ? 'Datele de contact vor fi anunțate.' : 'Contact details will be announced.') : eventConfig.email}</p>{!eventConfig.phone.startsWith('[DE COMPLETAT') && <p>{eventConfig.phone}</p>}<a href={`/${lang}/contact`}>{lang === 'ro' ? 'Pagina de contact ↗' : 'Contact page ↗'}</a></div>
      <div><h2>{lang === 'ro' ? 'Informații' : 'Information'}</h2><a href={`/${lang}/confidentialitate`}>{lang === 'ro' ? 'Confidențialitate' : 'Privacy'}</a><a href={`/${lang}/cookies`}>Cookies</a><a href={`/${lang}/termeni`}>{lang === 'ro' ? 'Termeni' : 'Terms'}</a><a href={`/${lang}/accesibilitate`}>{lang === 'ro' ? 'Accesibilitate' : 'Accessibility'}</a></div>
    </div><div class="footer-bottom wrap"><span>© {eventConfig.year} ONTI · Suceava, România</span><span>{lang === 'ro' ? 'Fotografii: Wikimedia Commons' : 'Photography: Wikimedia Commons'}</span></div></footer>
    <div class="cookie-banner" hidden role="dialog" aria-label="Preferințe cookie"><div><strong>Preferințe cookie</strong><p>Folosim doar cookie-uri funcționale. Analitica privacy-friendly este opțională.</p></div><button data-cookie="essential">Doar esențiale</button><button class="button button-small" data-cookie="all">Acceptă analitica</button></div>
    <script>
      // @ts-nocheck
      const header = document.querySelector('.site-header');
      const menu = document.querySelector('.menu-toggle');

      // Opens or closes the mobile menu and stops the page behind it from scrolling.
      function setMenuOpen(isOpen) {
        menu?.setAttribute('aria-expanded', String(isOpen));
        header?.classList.toggle('menu-open', isOpen);
        if (!isOpen) document.querySelectorAll<HTMLDetailsElement>('.more-nav').forEach((item) => item.removeAttribute('open'));
        document.body.classList.toggle('menu-locked', isOpen);
      }
      window.matchMedia('(min-width: 1051px)').addEventListener('change', () => setMenuOpen(false));
      menu?.addEventListener('click', () => setMenuOpen(menu.getAttribute('aria-expanded') !== 'true'));
      document.querySelectorAll('#main-nav a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || menu?.getAttribute('aria-expanded') !== 'true') return;
        setMenuOpen(false);
        menu.focus();
      });

      const loadAnalytics = () => { const domain = document.documentElement.dataset.plausibleDomain; if (!domain || document.querySelector('[data-ontic-analytics]')) return; const s = document.createElement('script'); s.defer = true; s.src = 'https://plausible.io/js/script.js'; s.dataset.domain = domain; s.dataset.onticAnalytics = 'true'; document.head.append(s); };
      const banner = document.querySelector('.cookie-banner'); const choice = localStorage.getItem('ontic-cookie-choice'); if (choice === 'all') loadAnalytics(); if (!choice && document.documentElement.dataset.plausibleDomain && !location.pathname.includes('/confidentialitate')) banner.hidden = false;
      document.querySelectorAll('[data-cookie]').forEach(b => b.addEventListener('click', () => { localStorage.setItem('ontic-cookie-choice', b.dataset.cookie); banner.hidden = true; if (b.dataset.cookie === 'all') loadAnalytics(); }));
    </script>
    <button class="back-top" type="button" hidden aria-label={lang === 'ro' ? 'Înapoi sus' : 'Back to top'}>⌃</button>
    <script>import '../scripts/experience';</script>
  </body>
</html>



