const filterButtons=document.querySelectorAll('[data-section-filter]');filterButtons.forEach(btn=>btn.addEventListener('click',()=>{filterButtons.forEach(b=>b.setAttribute('aria-pressed','false'));btn.setAttribute('aria-pressed','true');const chosen=btn.dataset.sectionFilter;document.querySelectorAll('.schedule-day').forEach(day=>{if(chosen==='all'){day.hidden=false;return}const activities=[...day.querySelectorAll('li')];day.hidden=!activities.some(li=>li.dataset.section==='all'||li.dataset.section===chosen||((chosen.startsWith('tic-'))&&li.dataset.section==='tic-ix'))})}));
const fs=document.querySelector('#faq-search');fs?.addEventListener('input',()=>{const q=fs.value.toLowerCase();let shown=0;document.querySelectorAll('.faq-item').forEach(x=>{x.hidden=!x.dataset.text.includes(q);if(!x.hidden)shown++});const count=document.querySelector('#faq-count');if(count)count.textContent=`${shown} întrebări`});
const esc=value=>String(value??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));const file=document.querySelector('#score-file');let rows=[];let sortKey='position';let sortDesc=false;const tbody=document.querySelector('#score-body');const anonymized=tbody?.closest('table')?.dataset.anonymized==='true',emptyCells=anonymized?8:9;const draw=()=>{if(!tbody)return;const q=(document.querySelector('#score-search')?.value||'').toLowerCase(),sec=document.querySelector('#score-section')?.value||'',county=document.querySelector('#score-county')?.value||'',award=document.querySelector('#score-award')?.value||'';let items=rows.filter(r=>(!q||Object.values(r).join(' ').toLowerCase().includes(q))&&(!sec||r.section===sec)&&(!county||r.county===county)&&(!award||r.award===award));items.sort((a,b)=>{const x=a[sortKey]??'',y=b[sortKey]??'';return (typeof x==='number'?x-Number(y):String(x).localeCompare(String(y)))*(sortDesc?-1:1)});if(tbody)tbody.innerHTML=items.length?items.map((r,i)=>`<tr><td>${esc(r.position??(i+1))}</td><td>${esc(r.code)}</td><td>${esc(r.section)}</td><td>${esc(r.grade)}</td><td>${esc(r.county)}</td><td>${esc(r.school)}</td><td>${esc(r.score??'')}</td><td class="medal">${esc(r.award)}</td>${!anonymized?`<td>${esc(r.participant||r.name)}</td>`:''}</tr>`).join(''):'<tr><td colspan="${emptyCells}">Nu există rezultate care corespund filtrelor.</td></tr>';const status=document.querySelector('#score-status');if(status)status.textContent=`${items.length} rezultate afișate`};
document.querySelectorAll('#score-search,#score-section,#score-county,#score-award').forEach(x=>x.addEventListener('input',draw));document.querySelectorAll('[data-sort]').forEach(b=>b.addEventListener('click',()=>{sortDesc=sortKey===b.dataset.sort?!sortDesc:false;sortKey=b.dataset.sort;draw()}));
file?.addEventListener('change',async()=>{const f=file.files[0];if(!f)return;const txt=await f.text();try{if(f.name.endsWith('.json'))rows=JSON.parse(txt);else{const [head,...lines]=txt.trim().split(/\r?\n/);const keys=head.split(',').map(x=>x.trim());rows=lines.map(l=>{const vals=l.match(/("[^"]*(?:""[^"]*)*"|[^,]*)(,|$)/g)||[];const cells=vals.map(x=>x.replace(/,$/,'').replace(/^"|"$/g,'').replace(/""/g,'"'));return Object.fromEntries(keys.map((k,i)=>[k,cells[i]]))})}rows=rows.map((r,i)=>({...r,position:Number(r.position)||i+1,score:Number(r.score)||0}));const counties=[...new Set(rows.map(r=>r.county).filter(Boolean))];const select=document.querySelector('#score-county');select.innerHTML='<option value="">Toate județele</option>'+counties.map(c=>`<option>${esc(c)}</option>`).join('');draw()}catch{document.querySelector('#score-status').textContent='Fișierul nu a putut fi citit. Verifică formatul CSV / JSON.'}});
document.querySelector('#score-export')?.addEventListener('click',()=>{const csv=['position,code,section,grade,county,school,score,award',...rows.map(r=>[r.position,r.code,r.section,r.grade,r.county,r.school,r.score,r.award].map(x=>`"${String(x??'').replaceAll('"','""')}"`).join(','))].join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='ontic-2027-rezultate.csv';a.click();URL.revokeObjectURL(a.href)});
if(document.querySelector('.countdown')){const target=new Date(document.querySelector('.countdown').dataset.date).getTime();const el=document.querySelector('#countdown');const update=()=>{const ms=target-Date.now();if(el)el.textContent=ms<=0?'Start':`${Math.floor(ms/86400000)} zile · ${Math.floor(ms%86400000/3600000)} ore · ${Math.floor(ms%3600000/60000)} min`};update();setInterval(update,60000)}
if(document.querySelector('#score-body')){const poll=async()=>{try{const r=await fetch('/api/results',{headers:{Accept:'application/json'}});if(!r.ok)return;const data=await r.json();if(Array.isArray(data.results)&&data.results.length){rows=data.results;draw();const status=document.querySelector('#score-status');if(status&&data.updatedAt)status.textContent=`Actualizat: ${new Date(data.updatedAt).toLocaleString()}`}}catch{/* offline: keep the current view */}};poll();setInterval(poll,60000)}
document.querySelectorAll('form[action^="/api/"]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const status=form.querySelector('.status');try{const r=await fetch(form.action,{method:'POST',body:new FormData(form)});const data=await r.json();status.textContent=data.message;if(r.ok)form.reset()}catch{status.textContent='Nu s-a putut trimite. Încearcă din nou mai târziu.'}}));
</script>


