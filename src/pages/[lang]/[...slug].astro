---
import Base from '../../layouts/Base.astro';
import { eventConfig, dateIsKnown } from '../../event.config';
import { faq, packages } from '../../content/site';
import { getEditorial } from '../../lib/editorial';
const lang = Astro.params.lang as 'ro' | 'en'; const slug = Astro.params.slug || ''; const isEn = lang === 'en';
const editorial = await getEditorial(); const pageNews = editorial.news; const pageSchedule = editorial.schedule;
const displayNewsTitle=(n:any)=>isEn?n.enTitle||n.title:n.title; const displayNewsText=(n:any)=>isEn?n.enText||n.text:n.text; const displayNewsCategory=(n:any)=>isEn?n.enCategory||n.category:n.category;
const displayNewsDate = (date: string) => date && !date.startsWith('[') ? ` · ${date}` : '';
const parts = slug.split('/'); const section = eventConfig.sections.find(s => s.id === parts[1]);
const names: Record<string,[string,string,string]> = {
  despre:['Despre ONTI','About ONTI','Olimpiada, traseul de calificare și echipele care o organizează.'], gazda:['Gazda','The host','Colegiul Național „Ștefan cel Mare” Suceava primește etapa națională ONTI 2027.'], participare:['Participare','Participation','Informații pentru elevi calificați, profesori, voluntari și presă.'], program:['Program','Schedule','Structura orientativă a celor cinci zile ONTI 2027.'], concurs:['Concurs','Contest','Explorează secțiunile, regulamentele, arhiva și rezultatele.'], locatii:['Locații și cazare','Venues and accommodation','Locul principal al probelor și informații logistice.'], bucovina:['Suceava și Bucovina','Suceava and Bucovina','Repere culturale, natură și ospitalitate locală.'], calatorie:['Călătorie','Travel','Cum ajungi la Suceava cu trenul, autobuzul, mașina sau avionul.'], galerie:['Galerie','Gallery','Imagini din Suceava și din pregătirea ediției.'], stiri:['Știri','News','Anunțuri și noutăți despre ONTI 2027.'], faq:['Întrebări frecvente','Frequently asked questions','Răspunsuri pentru elevi, profesori și familii.'], contact:['Contact','Contact','Scrie echipei de organizare a ONTI 2027.'], sponsori:['Sponsori și parteneri','Sponsors and partners','Susține o întâlnire națională dedicată excelenței în tehnologie.'], confidentialitate:['Confidențialitate','Privacy','Informații despre datele personale și drepturile persoanelor vizate.'], cookies:['Cookies','Cookies','Preferințe pentru cookie-uri și tehnologii similare.'], termeni:['Termeni de utilizare','Terms of use','Condițiile de utilizare ale site-ului ONTI 2027.'], accesibilitate:['Accesibilitate','Accessibility','Angajamentul nostru pentru un site accesibil tuturor.'], admin:['Administrare','Content editor','Editor protejat pentru program, știri și rezultate.']
};
let [title, enTitle, description] = names[parts[0]] || ['Pagină negăsită','Page not found','Pagina solicitată nu a fost găsită.'];
if (parts[0] === 'concurs' && parts[1] === 'rezultate') { title = isEn ? 'Rezultate și clasamente' : 'Rezultate și clasamente'; enTitle = 'Results and scoreboard'; }
if (parts[0] === 'concurs' && section) { title = section.title; enTitle = section.id === 'csharp' ? 'C# · grades IX–XII' : `ICT · grade ${section.grade}`; description = isEn ? 'Section rules, contest format, environment, archive and ranking.' : 'Regulament, structură, mediu de lucru, arhivă și clasament pentru această secțiune.'; }
if (parts[0] === 'stiri' && parts[1]) { const article = pageNews.find(n=>n.slug===parts[1]); title = article?.title || 'Știre'; enTitle = article?.enTitle || article?.title || 'News'; }
const notFound = !names[parts[0]] || (parts[0] === 'concurs' && Boolean(parts[1]) && parts[1] !== 'rezultate' && !section) || (parts[0] === 'stiri' && Boolean(parts[1]) && !pageNews.some(n=>n.slug===parts[1]));
if (notFound) { title = isEn ? 'Page not found' : 'Pagină negăsită'; enTitle = title; Astro.response.status = 404; }
const pageTitle = isEn ? enTitle : title;
const dayLabel = (d:number) => dateIsKnown && eventConfig.startDate ? new Date(new Date(eventConfig.startDate).getTime()+(d-1)*86400000).toLocaleDateString(isEn?'en-GB':'ro-RO',{day:'numeric',month:'long'}) : (isEn?`Day ${d}`:`Ziua ${d}`);
const unknown = (ro:string,en:string) => isEn ? en : ro;
const activityEn = (item:string) => ({ 'Primirea delegațiilor · [DE COMPLETAT: interval]':'Arrival of delegations · [TO BE COMPLETED: time]', 'Înregistrare și verificarea documentelor':'Registration and document check', 'Întâlnire de bun venit și informații logistice':'Welcome and logistics briefing', 'Deschiderea oficială · [DE COMPLETAT: oră]':'Official opening · [TO BE COMPLETED: time]', 'Turul spațiilor de concurs':'Contest venue tour', 'Întâlniri pentru elevi și profesori':'Student and teacher briefings', 'Acces în săli · [DE COMPLETAT: oră]':'Entry to contest rooms · [TO BE COMPLETED: time]', 'Probă practică TIC / C# · durată [DE COMPLETAT]':'Practical TIC / C# contest · duration [TO BE COMPLETED]', 'Program cultural pentru însoțitori':'Cultural programme for accompanying teachers', 'Publicarea rezultatelor inițiale':'Publication of preliminary results', 'Vizualizarea lucrărilor și contestații · conform regulamentului':'Work review and appeals · under the rules', 'Activități în Suceava și Bucovina':'Activities in Suceava and Bucovina', 'Publicarea rezultatelor finale':'Publication of final results', 'Festivitatea de premiere · [DE COMPLETAT: oră]':'Awards ceremony · [TO BE COMPLETED: time]', 'Plecarea delegațiilor':'Departure of delegations'} as Record<string,string>)[item] || item;
---
<Base lang={lang} title={pageTitle} description={description}>
  <section class="page-intro"><div class="wrap"><span class="eyebrow">ONTI 2027 · {eventConfig.city}</span><h1>{pageTitle}</h1><p>{isEn ? (parts[0] === 'despre' ? 'A national meeting for students who learn, design and build with technology.' : description) : description}</p></div></section>

  {parts[0] === 'program' && <section class="section"><div class="wrap"><div class="section-head"><div><span class="kicker">{unknown('PROGRAM ORIENTATIV','PROVISIONAL SCHEDULE')}</span><h2>{unknown('Cinci zile, în linii mari.','Five days, at a glance.')}</h2></div><div><button class="button button-small" onclick="window.print()">{unknown('Tipărește programul','Print schedule')} ↗</button> <a class:list={['button','button-small',!dateIsKnown&&'disabled']} aria-disabled={!dateIsKnown} href={dateIsKnown?'/api/calendar.ics':'#data-neanuntata'}>{unknown('Adaugă în calendar (.ics)','Add to calendar (.ics)')}</a></div></div>
    {!dateIsKnown && <div class="notice" id="data-neanuntata"><strong>{unknown('Data urmează să fie anunțată.','Date to be announced.')}</strong>{unknown('Până la publicarea datei oficiale, programul este prezentat pe zile fără date calendaristice. Orele și activitățile sunt orientative și vor fi confirmate.','Until the date is official, days are shown without calendar dates. Times and activities are indicative and will be confirmed.')}</div>}
    {dateIsKnown && <div class="countdown" data-date={eventConfig.startDate}><span class="kicker">{unknown('PÂNĂ LA ÎNCEPERE','COUNTDOWN')}</span><strong id="countdown">—</strong></div>}
    <div class="filters" aria-label={unknown('Filtrează programul pe secțiune','Filter schedule by section')}><button class="filter-btn" data-section-filter="all" aria-pressed="true">{unknown('Toate secțiunile','All sections')}</button>{eventConfig.sections.map(s=><button class="filter-btn" data-section-filter={s.id} style={`--accent:${s.color}`}>{s.short}</button>)}</div>
    <div class="timeline">{pageSchedule.map(d=><article class="timeline-item schedule-day" data-day={d.day}><div class="day">{dayLabel(d.day)}</div><div><h3>{isEn?d.en:d.title}</h3><ul>{d.items.map((item,j)=><li data-section={j===2?'csharp':j===1?'tic-ix':'all'}>{isEn?activityEn(item):item}</li>)}</ul></div></article>)}</div></div></section>}

  {parts[0] === 'concurs' && !parts[1] && <section class="section"><div class="wrap"><div class="notice"><strong>{unknown('Clasamente distincte, pentru formate distincte.','Separate rankings for separate formats.')}</strong>{unknown('TIC are clasament pe fiecare clasă; C# are un singur clasament comun pentru clasele IX–XII. ONTI este diferită de Olimpiada Națională de Informatică (ONI).','TIC has one ranking per grade; C# has one shared ranking for grades IX–XII. ONTI is distinct from Romania’s National Olympiad in Informatics (ONI).')}</div><div class="section-list" style="margin-top:2rem">{eventConfig.sections.map(s=><a class="section-chip" style={`--accent:${s.color}`} href={`/${lang}/concurs/${s.id}`}>{s.title}<small>{unknown('REGULAMENT · SUBIECTE · REZULTATE','RULES · TASKS · RESULTS')}</small></a>)}</div><p style="margin-top:2rem"><a class="button" href={`/${lang}/concurs/rezultate`}>{unknown('Deschide scoreboard','Open scoreboard')} ↗</a></p></div></section>}

  {parts[0] === 'concurs' && section && <section class="section"><div class="wrap"><div class="text-columns"><div class="prose"><div class="notice"><strong>{unknown('Documentele ediției 2027 se publică după validarea oficială.','2027 edition documents will be published after official approval.')}</strong>{unknown('Nu folosim reguli, subiecte sau punctaje provizorii drept informație oficială.','No draft rules, tasks or scores are presented as official.')}</div><h2>{unknown('Regulament','Rules')}</h2><p>{unknown('Regulamentul specific, programa și criteriile de evaluare pentru această secțiune sunt [DE COMPLETAT]. Până la publicare, se aplică documentele oficiale indicate de Ministerul Educației și Cercetării.','Section rules, syllabus and assessment criteria are [TO BE COMPLETED]. Until publication, consult the official documents issued by the Ministry of Education and Research.')}</p><a href="https://edu.ro/regulamente_olimpiade_concursuri_scolare_in_vigoare" target="_blank" rel="noreferrer">{unknown('Regulamente în vigoare pe edu.ro','Current rules on edu.ro')} ↗</a><h2>{unknown('Structura probei','Contest format')}</h2><ul><li>{unknown('Tipul probei: [DE COMPLETAT]','Contest type: [TO BE COMPLETED]')}</li><li>{unknown('Durată: [DE COMPLETAT]','Duration: [TO BE COMPLETED]')}</li><li>{unknown('Punctaj: [DE COMPLETAT]','Scoring: [TO BE COMPLETED]')}</li><li>{unknown('Programa: [DE COMPLETAT]','Syllabus: [TO BE COMPLETED]')}</li></ul><h2>{unknown('Mediu de lucru','Working environment')}</h2>{section.kind==='csharp'?<p>{unknown('Versiune .NET, IDE, biblioteci permise, limitări și procedura de evaluare: [DE COMPLETAT].',' .NET version, IDE, permitted libraries, restrictions and evaluation: [TO BE COMPLETED].')}</p>:<p>{unknown('Aplicațiile și mediile software folosite la proba TIC: [DE COMPLETAT]. Configurația laboratoarelor va fi publicată înaintea concursului.','Applications and software environments for the TIC contest: [TO BE COMPLETED]. Lab setup will be published before the contest.')}</p>}<h2>{unknown('Arhiva subiectelor și baremelor','Tasks and marking schemes archive')}</h2><div class="table-wrap"><table><thead><tr><th>{unknown('An','Year')}</th><th>{unknown('Subiect','Task')}</th><th>{unknown('Barem','Marking scheme')}</th></tr></thead><tbody><tr><td>2027</td><td>[DE COMPLETAT]</td><td>[DE COMPLETAT]</td></tr><tr><td>2026</td><td><a href="https://www.edu.ro/sites/default/files/_fi%C8%99iere/Minister/2026/olimpiade_concursuri/regulamente_actualizate/Regulament_Olimpiada_Nationala_TIC_2026.pdf" target="_blank" rel="noreferrer">{unknown('Consultă arhiva oficială','See official archive')} ↗</a></td><td>[DE COMPLETAT: link oficial]</td></tr></tbody></table></div><h2>{unknown('Contestații','Appeals')}</h2><p>{unknown('Termenele, modalitatea de depunere și accesul la lucrare vor urma regulamentul oficial 2027 și vor fi publicate odată cu rezultatele inițiale.','Deadlines, submission process and access to scripts follow the official 2027 rules and will be published with preliminary results.')}</p></div><aside class="card sidebar-card"><span class="kicker section-kicker" style={`--section-color:${section.color}`}>{section.short}</span><h3>{section.kind==='tic'?unknown('Clasament separat pe clasă','Separate grade ranking'):unknown('Clasament comun IX–XII','Shared IX–XII ranking')}</h3><p>{unknown('Rezultatele vor fi afișate după validare, cu respectarea normelor de protecție a datelor elevilor.','Results will be published after validation, following student privacy rules.')}</p><a class="button button-small" href={`/${lang}/concurs/rezultate?section=${section.id}`}>{unknown('Vezi rezultate','View results')} ↗</a></aside></div></div></section>}

  {parts[0] === 'concurs' && parts[1] === 'rezultate' && <section class="section"><div class="wrap"><div class="notice"><strong>{unknown('Rezultatele ONTI 2027 nu sunt publicate încă.','ONTI 2027 results are not published yet.')}</strong>{unknown('Scoreboard-ul este pregătit pentru importul fișierelor CSV sau JSON oficiale. Datele încărcate din browser rămân pe dispozitivul tău.','The scoreboard is ready to import official CSV or JSON files. Files loaded in the browser stay on your device.')}</div><div class="filter-grid" style="margin:1.5rem 0"><input class="search-input" id="score-search" type="search" placeholder={unknown('Caută cod, județ sau școală','Search code, county or school')} aria-label="Search results"/><select class="select-input" id="score-section"><option value="">{unknown('Toate secțiunile','All sections')}</option>{eventConfig.sections.map(s=><option value={s.id}>{s.short}</option>)}</select><select class="select-input" id="score-county"><option value="">{unknown('Toate județele','All counties')}</option></select><select class="select-input" id="score-award"><option value="">{unknown('Toate premiile','All awards')}</option><option>Premiul I</option><option>Premiul II</option><option>Premiul III</option><option>Mențiune</option></select><label class="button button-small" for="score-file">{unknown('Importă CSV / JSON','Import CSV / JSON')} ↑</label><input id="score-file" type="file" accept=".csv,.json,text/csv,application/json" hidden/><button class="button button-small" id="score-export">{unknown('Exportă CSV','Export CSV')} ↓</button><button class="button button-small" onclick="window.print()">PDF / {unknown('Tipărește','Print')} ↗</button><span class="status" id="score-status" aria-live="polite">{unknown('0 rezultate publicate · importă fișierul oficial','0 published results · import the official file')}</span></div><div class="table-wrap"><table id="score-table" data-anonymized={String(eventConfig.resultsAnonymized)}><thead><tr>{['position','code','section','class','county','school','score','award'].map((key,i)=><th><button data-sort={key}>{(isEn?['Rank','Code','Section','Grade','County','School','Score','Award']:['Loc','Cod','Secțiune','Clasa','Județ','Școală','Punctaj','Premiu'])[i]} ↕</button></th>)}{!eventConfig.resultsAnonymized && <th>{unknown('Participant','Participant')}</th>}</tr></thead><tbody id="score-body"><tr><td colspan={eventConfig.resultsAnonymized ? 8 : 9}>{unknown('Nu există rezultate publicate.','No results have been published.')}</td></tr></tbody></table></div><p class="status">{unknown('Format CSV/JSON: section, code, grade, county, school, score, award. Nu importa date personale identificabile.','CSV/JSON format: section, code, grade, county, school, score, award. Do not import identifiable personal data.')}</p><div class="notice" style="margin-top:1.5rem"><strong>{unknown('Actualizare automată','Automatic refresh')}</strong>{unknown('Scoreboard-ul verifică o dată pe minut dacă există actualizări oficiale.','The scoreboard checks once a minute for official updates.')}</div></div></section>}

  {parts[0] === 'despre' && <section class="section"><div class="wrap"><div class="text-columns"><div class="prose"><h2>{unknown('Tehnologia informației, prin proiecte și practică.','Information technology through projects and practice.')}</h2><p>{unknown('ONTI este Olimpiada Națională de Tehnologia Informației. Etapa națională reunește elevi calificați din țară pentru probe practice, în secțiuni distincte TIC și C#.','ONTI is Romania’s National Olympiad in Information Technology. Its national stage brings together qualified students for practical contests across TIC and C# sections.')}</p><h2>{unknown('ONTI și ONI sunt olimpiade diferite','ONTI and ONI are different olympiads')}</h2><p>{unknown('ONTI pune accent pe tehnologia informației și comunicațiilor, cu secțiuni TIC separate pe clase și o secțiune C# comună. Olimpiada Națională de Informatică (ONI) este o competiție distinctă, axată pe informatică și algoritmică. Au regulamente, probe și clasamente diferite.','ONTI focuses on information and communication technology, with separate TIC grade sections and one shared C# section. Romania’s National Olympiad in Informatics (ONI) is a separate competition focused on computer science and algorithms. They have different rules, tasks and rankings.')}</p><h2>{unknown('Drumul spre etapa națională','Path to the national stage')}</h2><div class="timeline"><article class="timeline-item"><span class="day">01</span><div><h3>{unknown('Etapa locală','Local stage')}</h3><p>{unknown('Selecție și participare potrivit calendarului școlar.','Selection and participation under the school calendar.')}</p></div></article><article class="timeline-item"><span class="day">02</span><div><h3>{unknown('Etapa județeană','County stage')}</h3><p>{unknown('Ierarhizare și calificare în condițiile regulamentului oficial.','Ranking and qualification under the official rules.')}</p></div></article><article class="timeline-item"><span class="day">03</span><div><h3>{unknown('Etapa națională · Suceava','National stage · Suceava')}</h3><p>{unknown('Cinci secțiuni de concurs, cu clasamentele prevăzute pentru TIC și C#.','Five contest sections, with the specified TIC and C# rankings.')}</p></div></article></div><h2>{unknown('Comisia națională și organizarea locală','National committee and local organization')}</h2><p>{unknown('Comisia națională: [DE COMPLETAT după publicarea componenței oficiale]. Comitetul de organizare locală: [DE COMPLETAT].','National committee: [TO BE COMPLETED when officially announced]. Local organizing committee: [TO BE COMPLETED].')}</p></div><aside class="card sidebar-card"><span class="kicker">2027</span><h3>{unknown('Găzduim excelența în Bucovina.','Excellence in Bucovina.')}</h3><p>{eventConfig.host}<br/>Suceava, România</p><a class="card-link" href={`/${lang}/gazda`}>{unknown('Despre gazdă →','About the host →')}</a></aside></div></div></section>}

  {parts[0] === 'gazda' && <section class="section"><div class="wrap"><div class="text-columns"><div class="prose"><figure class="school-photo"><img src="/images/cnscm-exterior.webp" width="1600" height="1200" alt={unknown('Fațada Colegiului Național „Ștefan cel Mare” Suceava','Façade of Colegiul Național „Ștefan cel Mare”, Suceava')} /><figcaption class="photo-credit"><a href="https://commons.wikimedia.org/wiki/File:%C8%98tefan_cel_Mare_National_College.jpg">Rosenborg BK Fan</a> · CC0</figcaption></figure><h2>{eventConfig.host}</h2><p>{unknown('Colegiul Național „Ștefan cel Mare” este instituția gazdă a etapei naționale ONTI 2027. Informațiile istorice și detaliile despre spațiile de concurs vor fi completate și verificate de echipa școlii.','Colegiul Național „Ștefan cel Mare” is hosting the ONTI 2027 national stage. The school team will provide verified history and information about contest spaces.')}</p><h2>{unknown('O școală cu tradiție, pregătită pentru viitor','A school with tradition, ready for the future')}</h2><p>{unknown('Istoric, laboratoare și facilități: [DE COMPLETAT cu informații și fotografii aprobate de CNSCM]. Capacitatea laboratoarelor și specificațiile echipamentelor vor fi publicate după verificare.','History, labs and facilities: [TO BE COMPLETED with CNSCM-approved details and photographs]. Lab capacity and equipment specifications will be published once verified.')}</p><h2>{unknown('Echipa de organizare','Organizing team')}</h2><p>[DE COMPLETAT: comitetul și rolurile, după confirmare oficială]</p></div><aside class="card sidebar-card"><span class="kicker">GAZDĂ / HOST</span><h3>{eventConfig.host}</h3><p>Suceava, România<br/>[DE COMPLETAT: adresă]</p><a class="card-link" href={`/${lang}/locatii`}>{unknown('Locații și cazare →','Venue and stay →')}</a></aside></div></div></section>}

  {parts[0] === 'participare' && <section class="section"><div class="wrap"><div class="notice"><strong>{unknown('Înscrierile oficiale nu sunt deschise încă.','Official registration is not open yet.')}</strong>{unknown('Formularele vor fi activate după confirmarea calendarului și a logisticii.','Forms will be enabled once the schedule and logistics are confirmed.')}</div><div class="cards" style="margin-top:1.5rem"><article class="card"><span class="kicker">01 / ELEV</span><h3>{unknown('Elevi calificați','Qualified students')}</h3><p>{unknown('Confirmare participare, documente necesare, program și informații pentru proba de concurs. Termene: [DE COMPLETAT].','Attendance confirmation, required documents, schedule and contest information. Deadlines: [TO BE COMPLETED].')}</p><a class="card-link" href={`/${lang}/concurs`}>{unknown('Secțiuni și reguli →','Sections and rules →')}</a></article><article class="card"><span class="kicker">02 / PROFESOR</span><h3>{unknown('Profesori însoțitori','Accompanying teachers')}</h3><p>{unknown('Formulare de cazare, masă și transport pentru delegații. Detalii și termene: [DE COMPLETAT].','Accommodation, meal and transport forms for delegations. Details and deadlines: [TO BE COMPLETED].')}</p><span class="status">[DE COMPLETAT: formulare oficiale]</span></article><article class="card"><span class="kicker">03 / COMUNITATE</span><h3>{unknown('Voluntari și presă','Volunteers and press')}</h3><p>{unknown('Rolurile voluntarilor și acreditarea presei se vor anunța odată cu deschiderea înscrierilor.','Volunteer roles and press accreditation will be announced when applications open.')}</p><a class="card-link" href={`/${lang}/contact`}>{unknown('Contactează organizatorii →','Contact organizers →')}</a></article></div><h2 style="margin-top:3rem">{unknown('Documente și termene','Documents and deadlines')}</h2><div class="table-wrap"><table><thead><tr><th>{unknown('Element','Item')}</th><th>{unknown('Stare','Status')}</th><th>{unknown('Detalii','Details')}</th></tr></thead><tbody>{['Regulament național','Confirmare participare','Cazare și masă','Transport și transferuri','Acorduri pentru minori'].map(x=><tr><td>{x}</td><td>[DE COMPLETAT]</td><td>[DE COMPLETAT: link / termen]</td></tr>)}</tbody></table></div><p class="status">{unknown('Pentru participanții minori, formularele vor solicita date minime și acordul părintelui/tutorelui sau al profesorului însoțitor, acolo unde este necesar.','For minors, forms will request minimal data and parent/guardian or accompanying teacher consent where required.')}</p></div></section>}

{parts[0] === 'locatii' && <section class="section"><div class="wrap"><div class="text-columns"><div class="prose"><div class="map-panel"><div class="leaflet-map" data-ontic-map data-lat="47.646" data-lon="26.261" role="application" aria-label="Hartă OpenStreetMap cu poziția orientativă a CNSCM Suceava"></div></div><h2>{unknown('Locul principal al probelor','Main contest venue')}</h2><p>{eventConfig.host}<br/>Suceava, România<br/>[DE COMPLETAT: adresă și săli]</p><h2>{unknown('Cazare și mese','Accommodation and meals')}</h2><p>{unknown('Opțiunile, tarifele, capacitățile și procedura de rezervare sunt [DE COMPLETAT]. Organizatorii vor publica opțiuni accesibile și informații despre masă după confirmare.','Options, rates, capacity and booking process are [TO BE COMPLETED]. Organizers will publish accessible options and meal information once confirmed.')}</p><h2>{unknown('Transport local','Local transport')}</h2><p>{unknown('Rețeaua TPL leagă cartierele orașului și zona metropolitană. Pentru poziția vehiculelor, stații și trasee, folosește harta oficială în timp real; orarele se pot modifica, așa că verifică-le în ziua deplasării.','The TPL network connects the city and metropolitan area. Use the official live map for vehicle locations, stops and routes; schedules may change, so check again on the day of travel.')}</p><div class="inline-links"><a class="button button-small" href="https://harta.tpl-sv.ro:8888/" target="_blank" rel="noreferrer">{unknown('Deschide harta TPL live','Open the live TPL map')} ↗</a><a class="card-link" href="https://visitsuceava.ro/transport-public-local-in-suceava/" target="_blank" rel="noreferrer">{unknown('Ghid transport Visit Suceava','Visit Suceava transport guide')} ↗</a></div></div><aside class="card sidebar-card"><span class="kicker">SUCEAVA</span><h3>{unknown('Planifică-ți sosirea','Plan your arrival')}</h3><p>{unknown('Gara, autogara și aeroportul sunt puncte de acces. Transferurile pentru eveniment nu sunt încă anunțate.','The railway station, coach terminal and airport are access points. Event transfers have not been announced yet.')}</p><a class="card-link" href={`/${lang}/calatorie`}>{unknown('Cum ajungi →','Getting here →')}</a></aside></div></div></section>}

{parts[0] === 'bucovina' && <section class="section"><div class="wrap"><div class="section-head"><div><span class="kicker">SUCEAVA · BUCOVINA</span><h2>{unknown('Trei locuri, trei feluri de a citi regiunea.','Three places, three ways to read the region.')}</h2></div><p>{unknown('Selecție pentru timpul liber al delegațiilor. Verifică programul și condițiile de acces direct la fiecare obiectiv înainte de vizită.','A short list for delegates’ free time. Check opening hours and access conditions with each venue before visiting.')}</p></div><div class="cards destination-cards"><article class="card"><figure class="card-media"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Cetatea_de_Scaun_a_Sucevei.jpg/1280px-Cetatea_de_Scaun_a_Sucevei.jpg" width="1280" height="960" loading="lazy" alt={unknown('Cetatea de Scaun a Sucevei','The Seat Fortress of Suceava')} /><figcaption>Cezar Suceveanu · CC BY 3.0</figcaption></figure><h3>Cetatea de Scaun a Sucevei</h3><p>{unknown('Fortăreața medievală este unul dintre reperele esențiale ale orașului și amintește de perioada în care Suceava a fost reședință domnească a Moldovei.','The medieval fortress is one of the city’s essential landmarks, recalling the era when Suceava was a princely residence of Moldavia.')}</p><a class="card-link" href="https://visitsuceava.ro/obiectiv-turistic/cetatea-de-scaun-a-sucevei/" target="_blank" rel="noreferrer">{unknown('Detalii pe Visit Suceava','Details on Visit Suceava')} ↗</a></article><article class="card"><figure class="card-media"><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Voronet%20Monastery.JPG?width=1280" width="1280" height="853" loading="lazy" alt={unknown('Mănăstirea Voroneț, cu picturile exterioare albastre','Voroneț Monastery with its blue exterior paintings')} /><figcaption>Aupaelfary · CC BY-SA 3.0 RO</figcaption></figure><h3>{unknown('Mănăstiri pictate','Painted monasteries')}</h3><p>{unknown('Bisericile Moldovei sunt recunoscute pentru frescele exterioare și fac parte din patrimoniul mondial UNESCO; Voroneț este una dintre cele mai cunoscute opriri.','The Churches of Moldavia are known for their exterior frescoes and form a UNESCO World Heritage site; Voroneț is among the best-known stops.')}</p><a class="card-link" href="https://whc.unesco.org/en/list/598/" target="_blank" rel="noreferrer">{unknown('Descoperă patrimoniul UNESCO','Explore the UNESCO heritage')} ↗</a></article><article class="card"><figure class="card-media"><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Muzeul%20Satului%20Bucovinean%2C%20Suceava.jpg?width=1280" width="1280" height="960" loading="lazy" alt={unknown('Gospodărie tradițională la Muzeul Satului Bucovinean','Traditional homestead at the Bucovina Village Museum')} /><figcaption>Georgiana Tudorica · CC BY-SA 3.0</figcaption></figure><h3>{unknown('Muzeul Satului Bucovinean','Bucovina Village Museum')}</h3><p>{unknown('Muzeul în aer liber reunește case, ateliere și gospodării tradiționale și se află în apropierea Cetății de Scaun.','The open-air museum brings together traditional homes, workshops and farmsteads near the Seat Fortress.')}</p><a class="card-link" href="https://visitsuceava.ro/muzeul-national-al-bucovinei/" target="_blank" rel="noreferrer">{unknown('Muzeele Bucovinei','Museums of Bucovina')} ↗</a></article></div><div class="text-columns" style="margin-top:2rem"><div class="prose"><h2>{unknown('Gustul locului','A taste of the region')}</h2><p>{unknown('Bucătăria locală aduce laolaltă produse de sezon, rețete de familie și ospitalitate. Pentru restaurante, cafenele și producători locali, consultă portalul turistic oficial al orașului.','Local food brings together seasonal produce, family recipes and hospitality. For restaurants, cafés and local producers, use the city’s official tourism portal.')}</p><a class="card-link" href="https://visitsuceava.ro/" target="_blank" rel="noreferrer">Visit Suceava · {unknown('portal turistic oficial','official tourism portal')} ↗</a><h2>{unknown('Excursii și timp liber','Excursions and free time')}</h2><p>{unknown('Programul cultural ONTI va fi publicat după confirmarea duratei și transportului. Activitățile delegațiilor vor fi organizate ținând cont de siguranța elevilor minori.','The ONTI cultural programme will be published once timing and transport are confirmed. Delegate activities will be organized with the safety of minor students in mind.')}</p></div><aside class="card useful-links"><span class="kicker">{unknown('LINKURI UTILE','USEFUL LINKS')}</span><h3>{unknown('Planifică o pauză bună.','Plan a good break.')}</h3><a href="https://visitsuceava.ro/obiective-turistice/" target="_blank" rel="noreferrer">{unknown('Obiective turistice','Places to visit')} <span>↗</span></a><a href="https://visitsuceava.ro/" target="_blank" rel="noreferrer">Visit Suceava <span>↗</span></a><a href="https://harta.tpl-sv.ro:8888/" target="_blank" rel="noreferrer">{unknown('Harta transportului TPL','TPL transport map')} <span>↗</span></a></aside></div></div></section>}

