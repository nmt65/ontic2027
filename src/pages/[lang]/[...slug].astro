---
import Base from '../../layouts/Base.astro';
import { eventConfig, dateIsKnown } from '../../event.config';
import { faq } from '../../content/site';
import { getEditorial } from '../../lib/editorial';

const lang = Astro.params.lang as 'ro' | 'en';
const isEn = lang === 'en';
const say = (ro: string, en: string) => isEn ? en : ro;
const slug = Astro.params.slug || '';
const parts = slug.split('/');
const section = eventConfig.sections.find((item) => item.id === parts[1]);
const { news } = await getEditorial();
const item = news.find((entry) => entry.slug === parts[1]);
const page = parts[0];
const pages: Record<string, [string, string, string]> = {
  despre: ['Despre ONTI', 'About ONTI', 'O competiție națională pentru elevi care construiesc cu tehnologie.'],
  gazda: ['Gazda', 'Our host', 'Colegiul Național „Ștefan cel Mare” Suceava găzduiește etapa națională.'],
  participare: ['Participare', 'Participation', 'Informații esențiale pentru elevi, profesori și delegații.'],
  program: ['Program', 'Schedule', 'O structură orientativă pentru cele cinci zile ale ediției.'],
  concurs: ['Concurs', 'Contest', 'Secțiuni, documente oficiale și rezultate.'],
  locatii: ['Hartă și locații', 'Map and venues', 'Harta TPL și repere utile pentru zilele petrecute în Suceava.'],
  bucovina: ['Suceava și Bucovina', 'Suceava and Bucovina', 'Un ghid scurt pentru timpul dintre probe.'],
  calatorie: ['Călătorie', 'Travel', 'Cum ajungi la Suceava și cum îți planifici sosirea.'],
  galerie: ['Galerie', 'Gallery', 'Câteva imagini din locul în care ne întâlnim.'],
  stiri: ['Noutăți', 'News', 'Informații publicate de echipa ONTI 2027.'],
  faq: ['Întrebări frecvente', 'Frequently asked questions', 'Răspunsuri clare pentru participanți și profesori.'],
  contact: ['Contact', 'Contact', 'Trimite un mesaj echipei de organizare.'],
};
const current = pages[page];
const found = Boolean(current) && !(page === 'concurs' && parts[1] && parts[1] !== 'rezultate' && !section) && !(page === 'stiri' && parts[1] && !item);
const title = page === 'concurs' && section ? section.title : page === 'stiri' && item ? (isEn ? item.enTitle || item.title : item.title) : current?.[isEn ? 1 : 0] || say('Pagina nu a fost găsită', 'Page not found');
const description = current?.[2] || say('Pagina solicitată nu este disponibilă.', 'The page you requested is unavailable.');
const fiveDays = [
  ['Sosire', 'Arrival', 'Primirea delegațiilor și informațiile esențiale.', 'Delegation arrival and essential information.'],
  ['Deschidere', 'Opening', 'Întâlnire de bun venit și acomodare.', 'Welcome and orientation.'],
  ['Concurs', 'Contest', 'Probele practice ale ediției.', 'The edition’s practical events.'],
  ['Rezultate', 'Results', 'Evaluare, contestații și timp în Suceava.', 'Evaluation, appeals and time in Suceava.'],
  ['Premiere', 'Awards', 'Rezultate finale și plecarea delegațiilor.', 'Final results and departure.'],
];
const cityStops = [
  { number: '01', ro: 'CNSCM', en: 'CNSCM', roDescription: 'Gazda ONTI 2027 și punctul principal al ediției.', enDescription: 'The ONTI 2027 host and the edition’s main venue.', latitude: 47.6466058, longitude: 26.2569654, x: 49.73, y: 54.48 },
  { number: '02', ro: 'Cetatea de Scaun', en: 'Seat Fortress', roDescription: 'Un reper ușor de recunoscut în zona estică a orașului.', enDescription: 'An easy-to-recognise landmark in the eastern part of the city.', latitude: 47.6448494, longitude: 26.2703335, x: 59.87, y: 56.46 },
  { number: '03', ro: 'Parcul Cetății', en: 'Citadel Park', roDescription: 'Spațiul verde de lângă Cetatea de Scaun.', enDescription: 'The green space next to the Seat Fortress.', latitude: 47.6462, longitude: 26.2721, x: 61.21, y: 54.94 },
  { number: '04', ro: 'Parcul Tătărași', en: 'Tătărași Park', roDescription: 'Parc de agrement în apropierea centrului.', enDescription: 'A recreation park close to the city centre.', latitude: 47.6357972, longitude: 26.2634523, x: 51.65, y: 64.59 },
  { number: '05', ro: 'Iulius Mall', en: 'Iulius Mall', roDescription: 'Punct comercial ușor de găsit, spre Burdujeni.', enDescription: 'An easy-to-find shopping landmark towards Burdujeni.', latitude: 47.6592433, longitude: 26.2698158, x: 59.48, y: 40.25 },
  { number: '06', ro: 'Gara Burdujeni', en: 'Burdujeni railway station', roDescription: 'Sosire cu trenul și legături spre oraș.', enDescription: 'Train arrivals and connections into the city.', latitude: 47.6705477, longitude: 26.2663, x: 56.81, y: 27.52 },
];
const mapTiles = [
  [4692, 2858], [4693, 2858], [4694, 2858],
  [4692, 2859], [4693, 2859], [4694, 2859],
  [4692, 2860], [4693, 2860], [4694, 2860],
];
---
<Base lang={lang} title={title} description={description}>
  {found && <section class={`page-intro${page === 'locatii' ? ' locations-intro' : ''}`}><div class="wrap"><p class="eyebrow">ONTI 2027 · Suceava</p><h1>{title}</h1><p>{description}</p></div></section>}

  {page === 'despre' && <section class="section"><div class="wrap reading-width prose"><h2>{say('Un loc pentru lucru bun, nu pentru zgomot.', 'A place for thoughtful work, not noise.')}</h2><p>{say('ONTI este Olimpiada Națională de Tehnologia Informației. Etapa națională reunește elevii calificați din țară în secțiunile TIC și C#, cu probe practice și rezultate publicate după validare.', 'ONTI is Romania’s National Olympiad in Information Technology. Its national stage brings together qualified students in TIC and C# sections, with practical events and results published after validation.')}</p><div class="quiet-callout"><strong>{say('ONTI nu este ONI.', 'ONTI is not ONI.')}</strong><span>{say('Sunt competiții diferite, cu probe și regulamente distincte.', 'They are different competitions with distinct formats and rules.')}</span></div><h2>{say('Drumul spre Suceava', 'The road to Suceava')}</h2><ol class="simple-steps"><li>{say('Etapa locală', 'Local stage')}</li><li>{say('Etapa județeană', 'County stage')}</li><li>{say('Etapa națională ONTI', 'ONTI national stage')}</li></ol></div></section>}

  {page === 'gazda' && <section class="section"><div class="wrap host-page"><img src="/images/cnscm-exterior.webp" width="1600" height="1200" alt={say('Colegiul Național Ștefan cel Mare din Suceava', 'Colegiul Național Ștefan cel Mare in Suceava')} /><div><span class="kicker">CNSCM SUCEAVA</span><h2>{say('Gazda ediției 2027', 'Host of the 2027 edition')}</h2><p>{say('Colegiul Național „Ștefan cel Mare” Suceava este locul în care îi primim pe participanții ONTI 2027.', 'Colegiul Național „Ștefan cel Mare” Suceava is where we welcome ONTI 2027 participants.')}</p><a class="button" href="https://cnstefancelmare.ro/" target="_blank" rel="noreferrer">{say('Vizitează site-ul CNSCM', 'Visit the CNSCM site')} ↗</a></div></div></section>}

  {page === 'participare' && <section class="section"><div class="wrap"><div class="quiet-callout"><strong>{say('Înscrierile nu sunt deschise încă.', 'Registration is not open yet.')}</strong><span>{say('Formularele și termenele apar aici numai după confirmarea organizatorilor.', 'Forms and deadlines will appear here only after organizers confirm them.')}</span></div><div class="info-columns"><article><span>01</span><h2>{say('Elevi calificați', 'Qualified students')}</h2><p>{say('Vei găsi aici confirmarea de participare, documentele și detaliile probei.', 'This is where confirmation, documents and contest details will be published.')}</p></article><article><span>02</span><h2>{say('Profesori însoțitori', 'Accompanying teachers')}</h2><p>{say('Cazarea, mesele și logistica delegațiilor vor fi centralizate aici.', 'Accommodation, meals and delegation logistics will be gathered here.')}</p></article><article><span>03</span><h2>{say('Voluntari și presă', 'Volunteers and press')}</h2><p>{say('Rolurile și acreditările vor fi anunțate împreună cu procedura de înscriere.', 'Roles and accreditations will be announced with the application process.')}</p></article></div></div></section>}

  {page === 'program' && <section class="section"><div class="wrap"><div class="schedule-note"><strong>{dateIsKnown ? say('Program confirmat', 'Confirmed schedule') : say('Program orientativ', 'Provisional schedule')}</strong><span>{dateIsKnown ? '' : say('Orele și data exactă vor fi publicate după confirmarea oficială.', 'Exact times and dates will be published after official confirmation.')}</span></div><ol class="schedule-clean">{fiveDays.map((day, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{isEn ? day[1] : day[0]}</h2><p>{isEn ? day[3] : day[2]}</p></div></li>)}</ol></div></section>}

  {page === 'concurs' && !parts[1] && <section class="section"><div class="wrap"><div class="quiet-callout"><strong>{say('TIC și C# au clasamente diferite.', 'TIC and C# use separate rankings.')}</strong><span>{say('TIC are clasamente pentru fiecare clasă, iar C# un clasament comun pentru IX–XII.', 'TIC has rankings by grade; C# has one shared IX–XII ranking.')}</span></div><div class="section-list clean-section-list">{eventConfig.sections.map((entry) => <a href={`/${lang}/concurs/${entry.id}`} style={`--accent:${entry.color}`}><span>{entry.short}</span><strong>{entry.title}</strong><b aria-hidden="true">→</b></a>)}</div></div></section>}

  {page === 'concurs' && section && <section class="section"><div class="wrap reading-width prose"><span class="kicker" style={`--section-color:${section.color}`}>{section.short}</span><h2>{section.title}</h2><p>{say('Documentele specifice ediției 2027 vor fi adăugate aici după publicarea lor oficială. Nu afișăm date provizorii drept informație confirmată.', 'Edition-specific documents will appear here after their official publication. We do not present draft information as confirmed.')}</p><a class="button" href="https://edu.ro/regulamente_olimpiade_concursuri_scolare_in_vigoare" target="_blank" rel="noreferrer">{say('Regulamente în vigoare', 'Current rules')} ↗</a></div></section>}

  {page === 'concurs' && parts[1] === 'rezultate' && <section class="section"><div class="wrap reading-width"><div class="quiet-callout"><strong>{say('Rezultatele vor apărea după validare.', 'Results will appear after validation.')}</strong><span>{say('Aici se vor publica clasamentele, cu respectarea regulilor de protecție a datelor elevilor.', 'This is where rankings will be published under student data-protection rules.')}</span></div></div></section>}

  {page === 'locatii' && <section class="section locations-page"><div class="wrap"><div class="locations-heading"><div><h2>{say('Repere utile pentru zilele în oraș.', 'Useful landmarks for your days in the city.')}</h2></div><p>{say('Vezi dintr-o privire unde sunt locurile importante pentru ONTI. Fiecare marcaj deschide traseul în Google Maps.', 'See at a glance where the important ONTI locations are. Each marker opens directions in Google Maps.')}</p></div><div class="landmarks-map" role="region" aria-label={say('Hartă cu repere ONTI în Suceava', 'Map of ONTI landmarks in Suceava')}><div class="landmarks-map-canvas"><div class="landmarks-map-tiles" aria-hidden="true">{mapTiles.map(([x, y]) => <img src={`https://tile.openstreetmap.org/13/${x}/${y}.png`} width="256" height="256" loading="lazy" alt="" />)}</div>{cityStops.map((stop) => <a class="landmark-marker" style={`--map-x:${stop.x}%;--map-y:${stop.y}%;`} href={`https://www.google.com/maps/dir/?api=1&destination=${stop.latitude},${stop.longitude}`} target="_blank" rel="noreferrer" aria-label={say(`Deschide traseul către ${stop.ro}`, `Open directions to ${stop.en}`)}><span aria-hidden="true">{stop.number}</span></a>)}</div><p class="map-attribution"><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">© OpenStreetMap contributors</a></p></div><ol class="city-stops">{cityStops.map((stop) => <li><span>{stop.number}</span><div><h3>{isEn ? stop.en : stop.ro}</h3><p>{isEn ? stop.enDescription : stop.roDescription}</p><a class="stop-directions" href={`https://www.google.com/maps/dir/?api=1&destination=${stop.latitude},${stop.longitude}`} target="_blank" rel="noreferrer">{say('Direcții în Google Maps', 'Directions in Google Maps')} <span aria-hidden="true">↗</span></a></div></li>)}</ol><div class="transport-map"><div><h2>{say('Transport public, în timp real.', 'Public transport, live.')}</h2><p>{say('Harta TPL rămâne aici pentru linii și vehicule. Folosește harta cu repere de mai sus ca să alegi destinația.', 'The TPL map remains here for routes and vehicles. Use the landmark map above to choose your destination.')}</p></div><div class="tpl-map-wrap"><iframe class="tpl-map-frame" src="https://harta.tpl-sv.ro:8888/" title={say('Harta live TPL Suceava', 'TPL Suceava live map')} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="geolocation"></iframe><a class="tpl-map-open" href="https://harta.tpl-sv.ro:8888/" target="_blank" rel="noreferrer">{say('Deschide harta TPL într-o filă nouă', 'Open the TPL map in a new tab')} <span aria-hidden="true">↗</span></a></div></div></div></section>}

  {page === 'bucovina' && <section class="section"><div class="wrap destination-grid"><article><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Cetatea_de_Scaun_a_Sucevei.jpg/1280px-Cetatea_de_Scaun_a_Sucevei.jpg" width="1280" height="960" loading="lazy" alt={say('Cetatea de Scaun a Sucevei', 'Suceava Seat Fortress')} /><h2>{say('Cetatea de Scaun', 'Seat Fortress')}</h2><a class="text-link" href="https://visitsuceava.ro/obiectiv-turistic/cetatea-de-scaun-a-sucevei/" target="_blank" rel="noreferrer">Visit Suceava ↗</a></article><article><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Voronet%20Monastery.JPG?width=1280" width="1280" height="853" loading="lazy" alt={say('Mănăstirea Voroneț', 'Voroneț Monastery')} /><h2>{say('Mănăstiri pictate', 'Painted monasteries')}</h2><a class="text-link" href="https://whc.unesco.org/en/list/598/" target="_blank" rel="noreferrer">UNESCO ↗</a></article><article><img src="/images/suceava-panorama.webp" width="1800" height="1013" loading="lazy" alt={say('Panoramă asupra Sucevei', 'Suceava panorama')} /><h2>{say('Orașul', 'The city')}</h2><a class="text-link" href="https://visitsuceava.ro/" target="_blank" rel="noreferrer">Visit Suceava ↗</a></article></div></section>}

  {page === 'calatorie' && <section class="section"><div class="wrap travel-layout"><img src="/images/gara-burdujeni.webp" width="1800" height="1013" loading="lazy" alt={say('Gara Burdujeni din Suceava', 'Burdujeni railway station in Suceava')} /><div><span class="kicker">SOSIRE</span><h2>{say('Vino informat, ajungi liniștit.', 'Plan ahead, arrive at ease.')}</h2><p>{say('Poți ajunge în Suceava cu trenul, autocarul, mașina sau avionul. Confirmă mereu ora și punctul exact de sosire direct cu operatorul de transport.', 'You can reach Suceava by train, coach, car or plane. Always confirm times and your exact arrival point directly with the transport operator.')}</p><a class="button button-small" href={`/${lang}/locatii`}>{say('Deschide harta ONTI', 'Open the ONTI map')}</a></div></div></section>}

  {page === 'galerie' && <section class="section"><div class="wrap gallery-clean"><img src="/images/cnscm-exterior.webp" width="1600" height="1200" loading="lazy" alt={say('Colegiul Național Ștefan cel Mare din Suceava', 'Colegiul Național Ștefan cel Mare in Suceava')} /><img src="/images/suceava-panorama.webp" width="1800" height="1013" loading="lazy" alt={say('Panoramă a Sucevei', 'Suceava panorama')} /><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Cetatea_de_Scaun_a_Sucevei.jpg/1280px-Cetatea_de_Scaun_a_Sucevei.jpg" width="1280" height="960" loading="lazy" alt={say('Cetatea de Scaun a Sucevei', 'Suceava Seat Fortress')} /></div></section>}

  {page === 'stiri' && <section class="section"><div class="wrap reading-width">{item ? <article class="prose"><span class="kicker">{isEn ? item.enCategory || item.category : item.category}</span><h2>{isEn ? item.enTitle || item.title : item.title}</h2><p>{isEn ? item.enText || item.text : item.text}</p><a class="text-link" href={`/${lang}/stiri`}>← {say('Toate noutățile', 'All news')}</a></article> : <ul class="news-list news-list-clean">{news.map((entry) => <li><a href={`/${lang}/stiri/${entry.slug}`}><span>{isEn ? entry.enCategory || entry.category : entry.category}</span><strong>{isEn ? entry.enTitle || entry.title : entry.title}</strong><b aria-hidden="true">→</b></a></li>)}</ul>}</div></section>}

  {page === 'faq' && <section class="section"><div class="wrap reading-width accordion">{faq.filter((entry) => !entry.a.includes('[DE COMPLETAT]')).map((entry) => <details class="faq-item"><summary>{isEn ? entry.enq : entry.q}</summary><p>{isEn ? entry.ena : entry.a}</p></details>)}</div></section>}

  {page === 'contact' && <section class="section"><div class="wrap contact-layout"><div><span class="kicker">ONTI 2027</span><h2>{say('Scrie echipei de organizare.', 'Write to the organizing team.')}</h2><p>{say('Datele oficiale de contact vor fi publicate după confirmarea lor. Până atunci, poți reveni aici pentru actualizări.', 'Official contact details will be published once confirmed. Until then, return here for updates.')}</p></div><form class="card form-grid" method="post" action="/api/contact"><div class="form-field"><label for="contact-name">{say('Nume', 'Name')}</label><input id="contact-name" name="name" required maxlength="100" autocomplete="name" /></div><div class="form-field"><label for="contact-email">Email</label><input id="contact-email" type="email" name="email" required maxlength="254" autocomplete="email" /></div><div class="form-field full"><label for="contact-message">{say('Mesaj', 'Message')}</label><textarea id="contact-message" name="message" rows="5" required maxlength="4000"></textarea></div><label class="honeypot" aria-hidden="true">Company<input name="website" tabindex="-1" autocomplete="off" /></label><label class="checkline form-field full"><input type="checkbox" name="consent" required/><span>{say('Sunt de acord ca datele mele să fie folosite pentru răspunsul la mesaj.', 'I agree that my data may be used to reply to this message.')}</span></label><button class="button form-field full" type="submit">{say('Trimite mesajul', 'Send message')} →</button></form></div></section>}

  {!found && <section class="section"><div class="wrap reading-width"><h2>404 · {say('Pagina nu a fost găsită.', 'Page not found.')}</h2><a class="button" href={`/${lang}`}>{say('Înapoi acasă', 'Back home')} →</a></div></section>}
</Base>
