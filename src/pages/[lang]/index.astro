---
import Base from '../../layouts/Base.astro';
import { eventConfig, dateIsKnown } from '../../event.config';
import { copy } from '../../content/site';
import { getEditorial } from '../../lib/editorial';
const lang = Astro.params.lang as 'ro' | 'en'; const t = copy[lang];
const { news: pageNews } = await getEditorial();
const newsTitle = (n: typeof pageNews[number]) => lang === 'ro' ? n.title : n.enTitle || n.title;
const newsText = (n: typeof pageNews[number]) => lang === 'ro' ? n.text : n.enText || n.text;
const newsCategory = (n: typeof pageNews[number]) => lang === 'ro' ? n.category : n.enCategory || n.category;
const title = lang === 'ro' ? 'Acasă' : 'Home';
---
<Base lang={lang} title={title}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content"><span class="eyebrow">{t.heroEyebrow}</span><h1 id="hero-title" set:html={t.heroTitle.replace('Bucovina.', '<em>Bucovina.</em>')}></h1><p>{t.heroText}</p><div class="hero-actions"><a class="button" href={`/${lang}/participare`}>{lang === 'ro' ? 'Pentru participanți' : 'For participants'} <span aria-hidden="true">↗</span></a><a class="button button-outline" href={`/${lang}/program`}>{lang === 'ro' ? 'Vezi programul' : 'View schedule'}</a><span class="date-pill" id={dateIsKnown ? 'hero-countdown' : undefined} data-date={dateIsKnown ? eventConfig.startDate : undefined}>{dateIsKnown ? (lang === 'ro' ? 'Calculăm timpul rămas…' : 'Calculating countdown…') : t.dateUnknown}</span></div></div>
    <figure class="hero-photo"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/01_CETATEA_DE_SCAUN_A_SUCEVEI_panorama.jpg/1280px-01_CETATEA_DE_SCAUN_A_SUCEVEI_panorama.jpg" width="1280" height="328" fetchpriority="high" alt={lang === 'ro' ? 'Panorama Cetății de Scaun a Sucevei, înconjurată de verdeață' : 'Panorama of the Seat Fortress of Suceava surrounded by greenery'} /><figcaption class="photo-label">{lang === 'ro' ? 'Un loc cu istorie. O generație cu viitor.' : 'A place with history. A generation with a future.'}</figcaption></figure><div class="hero-meta"><span>Suceava · România · 2027</span><a href="https://commons.wikimedia.org/wiki/File:01_CETATEA_DE_SCAUN_A_SUCEVEI_panorama.jpg" target="_blank" rel="noreferrer">Foto: Domino1027 · CC BY-SA 3.0 RO · {lang === 'ro' ? 'decupată' : 'cropped'}</a><span class="hero-scroll">{lang === 'ro' ? 'Explorează' : 'Explore'}</span></div>
  </section>

  <section class="section"><div class="wrap"><div class="section-head"><div><span class="kicker">01 / {lang === 'ro' ? 'Despre olimpiadă' : 'About the olympiad'}</span><h2>{t.homeIntro}</h2></div><p>{t.homeBody}</p></div>
    <div class="section-list">{eventConfig.sections.map(s=><a class="section-chip" style={`--accent:${s.color}`} href={`/${lang}/concurs/${s.id}`}>{s.title}<small>{s.kind === 'tic' ? (lang === 'ro' ? 'CLASAMENT SEPARAT' : 'SEPARATE RANKING') : (lang === 'ro' ? 'CLASAMENT COMUN' : 'SHARED RANKING')}</small></a>)}</div>
    <nav class="quick-links" aria-label={lang === 'ro' ? 'Informații utile' : 'Useful information'}>
      {[['01', lang === 'ro' ? 'Pregătește-ți participarea' : 'Prepare your participation', '/participare'], ['02', lang === 'ro' ? 'Programul olimpiadei' : 'Olympiad schedule', '/program'], ['03', lang === 'ro' ? 'Secțiuni și rezultate' : 'Sections and results', '/concurs']].map(([n,label,url]) => <a href={`/${lang}${url}`}><span>{n}</span><b>{label}</b><i aria-hidden="true">↗</i></a>)}
    </nav>
  </div></section>

  <section class="section section-tight"><div class="wrap"><div class="stats"><div class="stat"><strong>5</strong><span>{lang === 'ro' ? 'secțiuni de concurs' : 'contest sections'}</span></div><div class="stat"><strong>4 + 1</strong><span>{lang === 'ro' ? 'clasamente distincte' : 'distinct rankings'}</span></div><div class="stat"><strong>1</strong><span>{lang === 'ro' ? 'comunitate națională' : 'national community'}</span></div><div class="stat"><strong>2027</strong><span>{lang === 'ro' ? 'Suceava, Bucovina' : 'Suceava, Bucovina'}</span></div></div></div></section>

  <section class="section"><div class="wrap"><div class="section-head"><div><span class="kicker">02 / {lang === 'ro' ? 'Noutăți' : 'Updates'}</span><h2>{lang === 'ro' ? 'În pregătire, pas cu pas.' : 'Taking shape, step by step.'}</h2></div><a class="card-link" href={`/${lang}/stiri`}>{lang === 'ro' ? 'Toate noutățile →' : 'All updates →'}</a></div><div class="story-grid"><article class="story-feature"><span class="kicker">{newsCategory(pageNews[0])}</span><h3>{newsTitle(pageNews[0])}</h3><p>{newsText(pageNews[0])}</p><a class="button button-outline" href={`/${lang}/stiri/${pageNews[0].slug}`}>{lang === 'ro' ? 'Citește anunțul' : 'Read update'}</a></article><div class="story-list">{pageNews.slice(1).map(n=><article class="story-row"><small>{newsCategory(n)} · {n.date}</small><h3>{newsTitle(n)}</h3><a class="card-link" href={`/${lang}/stiri/${n.slug}`}>{lang === 'ro' ? 'Detalii →' : 'Details →'}</a></article>)}<article class="story-row"><small>PROGRAM</small><h3>{lang === 'ro' ? 'O structură orientativă pe cinci zile' : 'A five-day outline'}</h3><a class="card-link" href={`/${lang}/program`}>{lang === 'ro' ? 'Răsfoiește programul →' : 'Explore schedule →'}</a></article></div></div></div></section>

  <section class="section section-dark"><div class="wrap"><div class="section-head"><div><span class="kicker">03 / Bucovina</span><h2>{lang === 'ro' ? 'Concursul întâlnește locul.' : 'Where the contest meets its place.'}</h2></div><p>{lang === 'ro' ? 'Cetatea de Scaun, mănăstiri pictate și păduri de brad: Suceava oferă un cadru cu multă poveste pentru o întâlnire despre viitor.' : 'A medieval citadel, painted monasteries and spruce forests: Suceava brings a rich sense of place to a gathering about the future.'}</p></div><div class="place-feature"><figure><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Cetatea_de_Scaun_a_Sucevei.jpg/1280px-Cetatea_de_Scaun_a_Sucevei.jpg" width="1280" height="960" loading="lazy" decoding="async" alt={lang === 'ro' ? 'Zidurile din piatră ale Cetății de Scaun, Suceava' : 'Stone walls of the Seat Fortress, Suceava'} /><figcaption><a href="https://commons.wikimedia.org/wiki/File:Cetatea_de_Scaun_a_Sucevei.jpg">Cezar Suceveanu</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a> · {lang === 'ro' ? 'decupată' : 'cropped'}</figcaption></figure><div><span class="kicker">Suceava · Bucovina</span><h2>{lang === 'ro' ? 'Mai mult decât o destinație.' : 'More than a destination.'}</h2><p>{lang === 'ro' ? 'Între două provocări, descoperă un oraș în care trecutul rămâne aproape. Ziduri de cetate, străzi liniștite și povești de luat cu tine acasă.' : 'Between challenges, discover a city where the past feels close. Fortress walls, quiet streets and stories to take home.'}</p><a class="card-link" href={`/${lang}/bucovina`}>{lang === 'ro' ? 'Descoperă Bucovina' : 'Discover Bucovina'} ↗</a></div></div><div class="map-panel"><div class="leaflet-map" data-ontic-map data-lat="47.646" data-lon="26.261" role="application" aria-label="Hartă OpenStreetMap cu poziția orientativă a CNSCM Suceava"></div><div class="map-caption">{eventConfig.host} · Suceava, România · <a href="https://www.openstreetmap.org/?mlat=47.646&mlon=26.261#map=16/47.646/26.261" target="_blank" rel="noreferrer">{lang === 'ro' ? 'Deschide harta' : 'Open map'} ↗</a></div></div></div></section>

  <section class="section"><div class="wrap"><div class="section-head"><div><span class="kicker">04 / {lang === 'ro' ? 'Organizare' : 'Organizers'}</span><h2>{lang === 'ro' ? 'Împreună, pentru excelență.' : 'Together, for excellence.'}</h2></div><a class="card-link" href={`/${lang}/sponsori`}>{lang === 'ro' ? 'Devino partener →' : 'Become a partner →'}</a></div><div class="partners"><div class="partner"><strong>Organizator național</strong><p>Ministerul Educației și Cercetării</p></div><div class="partner"><strong>Organizator județean</strong><p>Inspectoratul Școlar Județean Suceava</p></div><div class="partner"><strong>Gazdă</strong><p>{eventConfig.host}</p></div></div></div></section>

  <section class="section section-tight"><div class="wrap"><div class="cta-band"><div><h2>{lang === 'ro' ? 'Vrei să afli când apare data?' : 'Want to know when the date is announced?'}</h2><p>{lang === 'ro' ? 'Un mesaj când avem confirmarea oficială. Atât.' : 'One message when the date is officially confirmed. That’s all.'}</p></div><a class="button" href={`/${lang}/#notify`}>{lang === 'ro' ? 'Anunță-mă' : 'Notify me'} ↓</a></div></div></section>
  <section class="section section-dark date-config" id="notify"><div class="wrap"><span class="kicker">ONTIC 2027</span><h2>{dateIsKnown ? (lang === 'ro' ? 'Ne vedem la Suceava.' : 'See you in Suceava.') : (lang === 'ro' ? 'Data nu e încă în calendar.' : 'The date is not on the calendar yet.')}</h2><p>{dateIsKnown ? (lang === 'ro' ? 'Data este publicată. Consultă programul și adaugă evenimentul în calendar.' : 'The date is official. View the schedule and add the event to your calendar.') : (lang === 'ro' ? 'Lasă-ne emailul și îți trimitem o notificare când data devine oficială.' : 'Leave your email and we will send an update when the date is official.')}</p>{!dateIsKnown && <form method="post" action="/api/notify"><label class="sr-only" for="notify-email">Email</label><input id="notify-email" name="email" type="email" autocomplete="email" placeholder="nume@exemplu.ro" required />{import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>}<label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><label class="checkline" style="text-align:left"><input type="checkbox" name="consent" value="yes" required /><span>{lang === 'ro' ? 'Sunt de acord ca adresa mea de email să fie folosită numai pentru notificarea despre data ONTIC 2027. Pot retrage acordul oricând.' : 'I agree that my email will only be used for an ONTIC 2027 date update. I can withdraw consent at any time.'}</span></label><button class="button" type="submit">{lang === 'ro' ? 'Anunță-mă când se publică data' : 'Notify me when announced'} ↗</button><p class="status" aria-live="polite"></p></form>}</div></section>
</Base>
<script>
// @ts-nocheck
const heroTimer=document.querySelector('#hero-countdown');if(heroTimer){const target=new Date(heroTimer.dataset.date).getTime(),ro=document.documentElement.lang==='ro';const update=()=>{const ms=target-Date.now();heroTimer.textContent=ms<=0?'ONTIC 2027 · Start':`${ro?'Mai sunt':'Starts in'} ${Math.floor(ms/86400000)} ${ro?'zile':'days'} · ${Math.floor(ms%86400000/3600000)} ${ro?'ore':'hours'}`};update();setInterval(update,60000)}
const form=document.querySelector('.date-config form');form?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;const status=f.querySelector('.status');try{const r=await fetch(f.action,{method:'POST',body:new FormData(f)});const d=await r.json();status.textContent=d.message; if(r.ok)f.reset()}catch{status.textContent='Nu s-a putut trimite. Încearcă din nou mai târziu.'}});
</script>
