---
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import { getEditorial } from '../../lib/editorial';

const lang = Astro.params.lang as 'ro' | 'en';
const ro = lang === 'ro';
const say = (romanian: string, english: string) => ro ? romanian : english;
const { news } = await getEditorial();
---
<Base lang={lang} title={say('Acasă', 'Home')}>
  <HomeHero lang={lang} />

  <section class="section quick-section" aria-labelledby="quick-title"><div class="wrap">
    <div class="section-head compact-head"><div><span class="kicker">ONTI 2027</span><h2 id="quick-title">{say('Tot ce ai nevoie, fără ocol.', 'Everything you need, without the detours.')}</h2></div></div>
    <nav class="quick-links" aria-label={say('Acces rapid', 'Quick links')}>
      <a href={`/${lang}/concurs`}><span>01</span><strong>{say('Concurs', 'Contest')}</strong><small>{say('Secțiuni și documente oficiale', 'Sections and official documents')}</small><b aria-hidden="true">→</b></a>
      <a href={`/${lang}/program`}><span>02</span><strong>{say('Program', 'Schedule')}</strong><small>{say('Structura ediției', 'Edition structure')}</small><b aria-hidden="true">→</b></a>
      <a href={`/${lang}/participare`}><span>03</span><strong>{say('Participare', 'Participation')}</strong><small>{say('Pentru elevi și profesori', 'For students and teachers')}</small><b aria-hidden="true">→</b></a>
      <a href={`/${lang}/locatii`}><span>04</span><strong>{say('Suceava', 'Suceava')}</strong><small>{say('Hartă, locații și deplasare', 'Map, venues and travel')}</small><b aria-hidden="true">→</b></a>
    </nav>
  </div></section>

  <section class="section city-story" aria-labelledby="city-title"><div class="wrap city-grid">
    <div class="city-image"><img src="/images/suceava-panorama.webp" width="1800" height="1013" loading="lazy" decoding="async" alt={say('Panoramă asupra orașului Suceava', 'Panorama of Suceava')} /></div>
    <div class="city-copy"><span class="kicker">SUCEAVA · BUCOVINA</span><h2 id="city-title">{say('Un oraș care îți lasă spațiu să descoperi.', 'A city that leaves room to discover.')}</h2><p>{say('Între probe, orașul se citește pe jos: colegiul, Cetatea de Scaun, muzeele și ritmul calm al Bucovinei.', 'Between events, the city is best explored on foot: the school, Seat Fortress, museums and Bucovina’s calm rhythm.')}</p><div class="inline-links"><a class="button button-small" href={`/${lang}/locatii`}>{say('Vezi harta noastră', 'See our map')}</a><a class="text-link" href={`/${lang}/bucovina`}>{say('Descoperă Bucovina', 'Discover Bucovina')}</a></div></div>
  </div></section>

  <section class="section news-section" aria-labelledby="news-title"><div class="wrap">
    <div class="section-head compact-head"><div><span class="kicker">{say('Actualizări', 'Updates')}</span><h2 id="news-title">{say('Noutăți', 'News')}</h2></div><a class="text-link" href={`/${lang}/stiri`}>{say('Toate noutățile', 'All news')} <span aria-hidden="true">→</span></a></div>
    <ul class="news-list news-list-clean" role="list">{news.slice(0, 3).map((item) => <li><a href={`/${lang}/stiri/${item.slug}`}><span>{ro ? item.category : item.enCategory || item.category}</span><strong>{ro ? item.title : item.enTitle || item.title}</strong><b aria-hidden="true">→</b></a></li>)}</ul>
  </div></section>
</Base>
