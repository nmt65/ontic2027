---
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import { getEditorial } from '../../lib/editorial';

const lang = Astro.params.lang as 'ro' | 'en';
const ro = lang === 'ro';
const say = (romanian: string, english: string) => ro ? romanian : english;
const { news } = await getEditorial();
const confirmedNews = news.filter((item) => item.date && !item.date.includes('[DE COMPLETAT'));
---
<Base lang={lang} title={say('Acasă', 'Home')}>
  <HomeHero lang={lang} />

  <section class="section essentials" aria-labelledby="essentials-title"><div class="wrap essentials-grid">
    <div class="essentials-intro"><h2 id="essentials-title">{say('Ce știm până acum.', 'What we know so far.')}</h2><p>{say('Aici găsești informațiile anunțate oficial despre concurs și despre organizarea ediției.', 'Here you can find the official information announced so far about the contest and its organisation.')}</p></div>
    <dl class="fact-sheet"><div><dt>{say('Locul principal', 'Main venue')}</dt><dd>{say('Colegiul Național „Ștefan cel Mare” Suceava', 'Colegiul Național „Ștefan cel Mare” Suceava')}</dd></div><div><dt>{say('Secțiuni', 'Sections')}</dt><dd>{say('TIC IX–XII și C# IX–XII', 'TIC IX–XII and C# IX–XII')}</dd></div><div><dt>{say('Calendar', 'Schedule')}</dt><dd>{say('Va fi publicat după confirmarea oficială', 'Published after official confirmation')}</dd></div></dl>
  </div></section>

  <section class="section routes" aria-labelledby="routes-title"><div class="wrap routes-grid">
    <div><h2 id="routes-title">{say('Alege ce ai de rezolvat.', 'Choose what you need to do.')}</h2></div>
    <nav class="route-list" aria-label={say('Informații principale', 'Primary information')}>
      <a href={`/${lang}/concurs`}><strong>{say('Concurs', 'Contest')}</strong><span>{say('Secțiuni, documente și rezultate', 'Sections, official documents and results')}</span><b aria-hidden="true">→</b></a>
      <a href={`/${lang}/program`}><strong>{say('Program', 'Schedule')}</strong><span>{say('Structura ediției și actualizări', 'Edition structure and updates')}</span><b aria-hidden="true">→</b></a>
      <a href={`/${lang}/participare`}><strong>{say('Participare', 'Participation')}</strong><span>{say('Informații pentru elevi și profesori', 'Information for students and teachers')}</span><b aria-hidden="true">→</b></a>
      <a href={`/${lang}/locatii`}><strong>{say('Orientare în Suceava', 'Getting around Suceava')}</strong><span>{say('Harta ONTI, locații și sosire', 'ONTI map, venues and arrival')}</span><b aria-hidden="true">→</b></a>
    </nav>
  </div></section>

  <section class="section suceava-file" aria-labelledby="suceava-title"><div class="wrap suceava-file-grid">
    <div class="suceava-photo-stack"><img src="https://img.svnews.ro/foto/2024/08/16/398466/3581b5fb28f91775d2ee523df06500433.jpg" width="1800" height="1350" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt={say('Parada trupelor la Festivalul Medieval, Cetatea de Scaun a Sucevei', 'Troupe parade at the Medieval Festival, Suceava Seat Fortress')} /><img src="https://www.cinemasuceava.ro/site/assets/files/6193/a-inceput-bucovina-rock-castle-2017-program-cinemasuceava.ro-4rlor.630x420.jpg" width="630" height="420" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt={say('Concert la Bucovina Rock Castle, la Cetatea de Scaun', 'Concert at Bucovina Rock Castle, at the Seat Fortress')} /></div>
    <div class="suceava-file-copy"><h2 id="suceava-title">{say('Despre Suceava.', 'About Suceava.')}</h2><p>{say('Pentru deplasare și orientare, ai harta ONTI cu principalele repere din oraș. Pentru idei de vizită, găsești separat pagina despre Bucovina.', 'For travel and orientation, the ONTI map includes the main landmarks in the city. For ideas on what to visit, the Bucovina page is separate.')}</p><a class="text-link" href={`/${lang}/locatii`}>{say('Deschide harta ONTI', 'Open the ONTI map')} →</a></div>
  </div></section>

  <section class="section updates" aria-labelledby="news-title"><div class="wrap updates-grid"><div><h2 id="news-title">{say('Actualizări.', 'Updates.')}</h2><a class="text-link" href={`/${lang}/stiri`}>{say('Vezi noutățile', 'View updates')} →</a></div>{confirmedNews.length ? <ul class="news-list dossier-news" role="list">{confirmedNews.slice(0, 3).map((item) => <li><a href={`/${lang}/stiri/${item.slug}`}><span>{ro ? item.category : item.enCategory || item.category}</span><strong>{ro ? item.title : item.enTitle || item.title}</strong><b aria-hidden="true">→</b></a></li>)}</ul> : <p>{say('Nu există încă anunțuri datate publicate. Actualizările confirmate vor apărea aici cu data și sursa lor.', 'There are no dated announcements published yet. Confirmed updates will appear here with their date and source.')}</p>}</div></section>
</Base>
