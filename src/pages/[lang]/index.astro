---
import Base from '../../layouts/Base.astro';
import { eventConfig, dateIsKnown } from '../../event.config';
import { getEditorial } from '../../lib/editorial';

const lang = Astro.params.lang as 'ro' | 'en';
const ro = lang === 'ro';
const say = (romanian: string, english: string) => (ro ? romanian : english);
const { news } = await getEditorial();

// Wikimedia Commons photographs. Credits are shown next to each image.
const fortressPhoto = 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Cetatea_de_Scaun_a_Sucevei.jpg/1280px-Cetatea_de_Scaun_a_Sucevei.jpg';
const voronetPhoto = 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Voronet%20Monastery.JPG?width=1280';

// TIC has one ranking per grade; C# has one shared ranking.
const ticRankingCount = eventConfig.sections.filter((section) => section.kind === 'tic').length;
const formattedStartDate = dateIsKnown
  ? new Date(eventConfig.startDate!).toLocaleDateString(ro ? 'ro-RO' : 'en-GB', { dateStyle: 'long', timeZone: 'Europe/Bucharest' })
  : null;
---
<Base lang={lang} title={say('Acasă', 'Home')}>
  <section class="launch-hero" aria-labelledby="launch-title">
    <p class="hero-event"><strong>ONTIC 2027</strong><span>Suceava, România</span></p>
    <h1 id="launch-title">{say('Viitorul începe', 'The future starts')}<br /><span>{say('cu ideile tale.', 'with your ideas.')}</span></h1>
    <p class="hero-description">{say('Etapa națională a Olimpiadei de Tehnologia Informației și Comunicațiilor: cinci secțiuni, elevi din toată țara, o săptămână în Bucovina.', 'The national stage of Romania’s Information and Communication Technology Olympiad: five sections, students from across the country, one week in Bucovina.')}</p>
    <div class="launch-actions">
      <a class="button" href={`/${lang}/participare`}>{say('Ghid de participare', 'Participation guide')}</a>
      <a class="text-link" href={`/${lang}/concurs`}>{say('Secțiuni și regulamente', 'Sections and rules')} <span aria-hidden="true">→</span></a>
    </div>
    <figure class="hero-landscape">
      <img src={fortressPhoto} width="1280" height="960" fetchpriority="high" alt={say('Zidurile Cetății de Scaun a Sucevei', 'The walls of Suceava’s Seat Fortress')} />
      <figcaption class="landscape-label"><span>{say('Un oraș cu istorie. O generație cu viitor.', 'A city with history. A generation with a future.')}</span><strong>Suceava. 2027.</strong></figcaption>
    </figure>
  </section>
  <p class="photo-credit hero-credit"><a href="https://commons.wikimedia.org/wiki/File:Cetatea_de_Scaun_a_Sucevei.jpg">Cezar Suceveanu</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a> · {say('fotografie decupată', 'cropped photograph')}</p>

  <section class="date-band" id="date-updates" aria-labelledby="date-title">
    <div class="wrap date-band-inner">
      <div>
        <span class="kicker">{say('Etapa națională', 'National stage')}</span>
        <h2 id="date-title">{dateIsKnown ? formattedStartDate : say('Data nu e încă în calendar.', 'The date is not on the calendar yet.')}</h2>
        <p>{dateIsKnown
          ? say(`${eventConfig.durationDays} zile la ${eventConfig.host}.`, `${eventConfig.durationDays} days at ${eventConfig.host}.`)
          : say('Lasă-ne emailul și îți trimitem un singur mesaj când data devine oficială.', 'Leave your email and we will send one message when the date is official.')}</p>
      </div>
      {dateIsKnown ? (
        <div class="date-band-actions">
          <a class="button button-gold" href="/api/calendar.ics">{say('Adaugă în calendar', 'Add to calendar')}</a>
          <a class="text-link" href={`/${lang}/program`}>{say('Vezi programul', 'View schedule')} <span aria-hidden="true">→</span></a>
        </div>
      ) : (
        <form class="notify-form" method="post" action="/api/notify">
          <div class="notify-row">
            <label class="sr-only" for="notify-email">Email</label>
            <input id="notify-email" name="email" type="email" autocomplete="email" placeholder="nume@exemplu.ro" required />
            <button class="button button-gold" type="submit">{say('Anunță-mă', 'Notify me')}</button>
          </div>
          {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>}
          <label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <label class="checkline">
            <input type="checkbox" name="consent" value="yes" required />
            <span>{say('Sunt de acord ca emailul meu să fie folosit numai pentru anunțul datei ONTIC 2027. Pot retrage acordul oricând.', 'I agree that my email will only be used to announce the ONTIC 2027 date. I can withdraw consent at any time.')}</span>
          </label>
          <p class="status" aria-live="polite"></p>
        </form>
      )}
    </div>
  </section>

  <section class="section" id="discover" aria-labelledby="intro-title"><div class="wrap">
    <div class="intro-statement" data-reveal>
      <span class="kicker">{say('Curios. Creativ. Pregătit.', 'Curious. Creative. Ready.')}</span>
      <h2 id="intro-title">{say('Mai mult decât un concurs.', 'More than a competition.')} <span>{say('Locul în care pasiunea pentru tehnologie prinde formă.', 'Where a passion for technology takes shape.')}</span></h2>
      <p>{say('Elevi din toată țara, profesori care îi inspiră și provocări care duc ideile mai departe. Ne întâlnim la Colegiul Național „Ștefan cel Mare” Suceava.', 'Students from across Romania, inspiring teachers and challenges that take ideas further. We meet at Colegiul Național „Ștefan cel Mare” in Suceava.')}</p>
    </div>
    <div class="fact-row" data-reveal>
      <div><strong>{eventConfig.sections.length}</strong><span>{say('secțiuni de concurs', 'contest sections')}</span></div>
      <div><strong>{ticRankingCount} + 1</strong><span>{say('clasamente: TIC pe clase, C# comun', 'rankings: TIC by grade, one for C#')}</span></div>
      <div><strong>{eventConfig.durationDays}</strong><span>{say('zile la Suceava', 'days in Suceava')}</span></div>
    </div>
  </div></section>

  <section class="section soft-section" aria-labelledby="tracks-title"><div class="wrap">
    <div class="section-head" data-reveal>
      <div><span class="kicker">{say('Concursul', 'The competition')}</span><h2 id="tracks-title">{say('Talente diferite.', 'Different talents.')}<br />{say('Aceeași ambiție.', 'The same ambition.')}</h2></div>
      <p>{say('Alege secțiunea ta și găsește regulamentele, informațiile despre probe și rezultatele, pe măsură ce sunt publicate.', 'Find your section, its rules, contest information and results as they are published.')}</p>
    </div>
    <div class="track-grid">
      <article class="track-card" data-reveal>
        <div class="track-orbit" aria-hidden="true"></div>
        <span class="kicker">{say('Tehnologia informației', 'Information technology')}</span>
        <div class="track-symbol" aria-hidden="true">TIC.</div>
        <h3>{say('Transformă ce știi în ce poți.', 'Turn knowledge into possibility.')}</h3>
        <p>{say('Probe practice și clasamente distincte pentru fiecare clasă. Aici, atenția la detalii întâlnește creativitatea.', 'Practical challenges and separate rankings for each grade. Where attention to detail meets creativity.')}</p>
        <div class="grade-links">{eventConfig.sections.filter((section) => section.kind === 'tic').map((section) => <a href={`/${lang}/concurs/${section.id}`}>{say('Clasa ', 'Grade ')}{section.grade}</a>)}</div>
      </article>
      <article class="track-card violet" data-reveal>
        <div class="track-orbit" aria-hidden="true"></div>
        <span class="kicker">{say('Programare', 'Programming')}</span>
        <div class="track-symbol" aria-hidden="true">C#</div>
        <h3>{say('Idei care devin aplicații.', 'Ideas that become applications.')}</h3>
        <p>{say('O secțiune comună pentru clasele IX–XII. Gândire structurată, soluții clare și bucuria de a construi.', 'One shared section for grades IX–XII. Structured thinking, clear solutions and the joy of building.')}</p>
        <a class="button" href={`/${lang}/concurs/csharp`}>{say('Explorează secțiunea C#', 'Explore the C# section')}</a>
      </article>
    </div>
  </div></section>

  <section class="section" aria-labelledby="journey-title"><div class="wrap">
    <div class="section-head" data-reveal>
      <div><span class="kicker">{say('Pentru participanți', 'For participants')}</span><h2 id="journey-title">{say('Mai puține căutări.', 'Less searching.')}<br />{say('Mai multă claritate.', 'More clarity.')}</h2></div>
      <a class="text-link" href={`/${lang}/faq`}>{say('Întrebări frecvente', 'Frequently asked questions')} <span aria-hidden="true">→</span></a>
    </div>
    <div class="journey-grid">
      <a class="journey-card" href={`/${lang}/program`} data-reveal><span class="journey-icon" aria-hidden="true">▦</span><h3>{say('Programul tău.', 'Your schedule.')}</h3><p>{say('De la prima întâlnire până la premiere. Urmărește structura și actualizările programului.', 'From the first meeting to the awards. Follow the schedule and its updates.')}</p><span class="text-link">{say('Vezi programul', 'View schedule')} <span aria-hidden="true">→</span></span></a>
      <a class="journey-card" href={`/${lang}/participare`} data-reveal><span class="journey-icon" aria-hidden="true">✓</span><h3>{say('Totul pregătit.', 'Ready to take part.')}</h3><p>{say('Informații pentru elevi, profesori și delegații, adunate într-un singur loc.', 'Information for students, teachers and delegations, all in one place.')}</p><span class="text-link">{say('Ghid de participare', 'Participation guide')} <span aria-hidden="true">→</span></span></a>
      <a class="journey-card" href={`/${lang}/locatii`} data-reveal><span class="journey-icon" aria-hidden="true">⌖</span><h3>{say('Ajungi mai ușor.', 'Find your way.')}</h3><p>{say('Locații, cazare și harta live TPL, ca să te orientezi ușor în Suceava.', 'Venues, accommodation and the live TPL map to help you navigate Suceava.')}</p><span class="text-link">{say('Locații și transport', 'Venues and transport')} <span aria-hidden="true">→</span></span></a>
    </div>
  </div></section>

  <section class="section soft-section heritage-section" aria-labelledby="destination-title"><div class="wrap destination-feature">
    <figure data-reveal>
      <img src={voronetPhoto} width="1280" height="853" loading="lazy" decoding="async" alt={say('Mănăstirea Voroneț, cu picturile exterioare albastre', 'Voroneț Monastery with its blue exterior paintings')} />
      <figcaption class="photo-credit"><a href="https://commons.wikimedia.org/wiki/File:Voronet_Monastery.JPG">Aupaelfary</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/ro/">CC BY-SA 3.0 RO</a></figcaption>
    </figure>
    <div data-reveal>
      <span class="kicker">{say('Dincolo de concurs', 'Beyond the competition')}</span>
      <h2 id="destination-title">{say('Închide laptopul.', 'Close your laptop.')}<br />{say('Deschide orizontul.', 'Open your horizons.')}</h2>
      <p>{say('Cetatea de Scaun, mănăstirile pictate și ospitalitatea Bucovinei. Între două provocări, descoperă locul care ne aduce împreună.', 'The Seat Fortress, the painted monasteries and Bucovina’s hospitality. Between challenges, discover the place that brings us together.')}</p>
      <a class="button" href={`/${lang}/bucovina`}>{say('Descoperă Bucovina', 'Discover Bucovina')}</a>
      <div class="destination-links">
        <a class="text-link" href="https://visitsuceava.ro/" target="_blank" rel="noreferrer">Visit Suceava <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="https://harta.tpl-sv.ro:8888/" target="_blank" rel="noreferrer">{say('Harta TPL live', 'Live TPL map')} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div></section>

  <section class="section" aria-labelledby="news-title"><div class="wrap">
    <div class="section-head" data-reveal>
      <div><span class="kicker">{say('La curent', 'Stay informed')}</span><h2 id="news-title">{say('Noutăți', 'Updates')}</h2></div>
      <a class="text-link" href={`/${lang}/stiri`}>{say('Toate noutățile', 'All updates')} <span aria-hidden="true">→</span></a>
    </div>
    <ul class="news-list" role="list">
      {news.slice(0, 3).map((item) => (
        <li data-reveal>
          <a href={`/${lang}/stiri/${item.slug}`}>
            <span class="kicker">{ro ? item.category : item.enCategory || item.category}</span>
            <strong>{ro ? item.title : item.enTitle || item.title}</strong>
            <span class="news-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div></section>

  <section class="section section-tight" aria-labelledby="partners-title"><div class="wrap">
    <span class="kicker" id="partners-title">{say('Împreună pentru educație', 'Together for education')}</span>
    <div class="partners">
      <div class="partner"><strong>{say('Organizator național', 'National organizer')}</strong><p>Ministerul Educației și Cercetării</p></div>
      <div class="partner"><strong>{say('Organizator județean', 'County organizer')}</strong><p>Inspectoratul Școlar Județean Suceava</p></div>
      <div class="partner"><strong>{say('Gazdă', 'Host')}</strong><p>{eventConfig.host}</p></div>
    </div>
  </div></section>
</Base>

<script>
  // Sends the date-notification form without leaving the page and shows the server's reply.
  const notifyForm = document.querySelector<HTMLFormElement>('.notify-form');
  const FALLBACK_ERROR = document.documentElement.lang === 'ro'
    ? 'Nu s-a putut trimite. Încearcă din nou mai târziu.'
    : 'Could not send. Please try again later.';

  notifyForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = notifyForm.querySelector('.status');
    if (!status) return;
    try {
      const response = await fetch(notifyForm.action, { method: 'POST', body: new FormData(notifyForm) });
      const result = await response.json();
      status.textContent = result.message;
      if (response.ok) notifyForm.reset();
    } catch (error) {
      console.error('Notify form failed', error);
      status.textContent = FALLBACK_ERROR;
    }
  });
</script>
